        }
        lines {
          text: "export default function AboutPage() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const principles = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Clart\303\251\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'Pas de jargon technique derri\303\250re lequel se cacher. Seulement des progr\303\250s transparents et des conseils honn\303\252tes. Nous traduisons l\\\'ing\303\251nierie complexe en r\303\251sultats commerciaux clairs.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Qualit\303\251\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'Nous refusons de livrer un travail m\303\251diocre. Chaque pixel, chaque interaction et chaque ligne de code sont m\303\251ticuleusement con\303\247us pour r\303\251pondre \303\240 un objectif pr\303\251cis.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Transparence\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'Une visibilit\303\251 totale sur notre processus, nos tarifs et nos d\303\251lais. Vous ne vous demanderez jamais quel est le statut de votre projet ou la logique derri\303\250re nos d\303\251cisions.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Fiabilit\303\251\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'Nous livrons ce que nous promettons, quand nous le promettons. Nous consid\303\251rons nos engagements comme une architecture absolue, pas comme des suggestions flexibles.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Am\303\251lioration continue\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      description: \'Le lancement n\\\'est que le point de d\303\251part. Nous concevons des plateformes num\303\251riques sp\303\251cifiquement con\303\247ues pour \303\251voluer, s\\\'adapter et r\303\251pondre aux \303\251volutions du march\303\251.\'"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
