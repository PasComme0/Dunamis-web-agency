        }
        lines {
          text: "          <div className=\"flex flex-col border-t border-border\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            {["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                q: \"Combien co\303\273te un site web ?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                a: \"Les co\303\273ts des projets varient en fonction de la complexit\303\251, des fonctionnalit\303\251s et des d\303\251lais. Apr\303\250s un bref appel de d\303\251couverte pour comprendre vos besoins, nous fournissons une proposition d\303\251taill\303\251e et transparente avec un prix fixe. Nous ne croyons pas aux frais cach\303\251s.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                q: \"Combien de temps prend g\303\251n\303\251ralement un projet ?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                a: \"Un site web d\'entreprise standard prend g\303\251n\303\251ralement de 4 \303\240 6 semaines, de la d\303\251couverte au lancement. Des applications web ou des plateformes e-commerce plus complexes peuvent prendre de 8 \303\240 12 semaines. Nous \303\251tablissons un calendrier pr\303\251cis lors de la phase de strat\303\251gie et nous nous y tenons strictement.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                q: \"Faites-vous la refonte de sites web existants ?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                a: \"Oui. Nous aidons souvent les entreprises \303\240 moderniser leurs plateformes existantes. Nous commen\303\247ons par un audit UX et technique complet pour d\303\251terminer si une refonte it\303\251rative ou une reconstruction compl\303\250te est l\'approche la plus rentable.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                q: \"Proposez-vous une maintenance continue ?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                a: \"Absolument. Nous consid\303\251rons le lancement comme le d\303\251but de notre partenariat. Nous proposons des forfaits de support et de maintenance structur\303\251s pour garantir que votre produit num\303\251rique reste s\303\251curis\303\251, rapide et align\303\251 sur l\'\303\251volution de vos besoins commerciaux.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
