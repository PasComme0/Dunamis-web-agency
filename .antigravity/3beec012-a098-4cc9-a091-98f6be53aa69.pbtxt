  user_input {
    user_response: "Here is the full initial file tree for the application:\n/.env.example\n/.eslintrc.json\n/.gitignore\n/app/about/page.tsx\n/app/contact/page.tsx\n/app/globals.css\n/app/layout.tsx\n/app/page.tsx\n/app/resources/page.tsx\n/app/services/page.tsx\n/app/work/page.tsx\n/assets/.aistudio/.gitignore\n/bun.lock\n/components/layout/Footer.tsx\n/components/layout/Navbar.tsx\n/components/layout/SmoothScrolling.tsx\n/components/ui/Reveal.tsx\n/eslint.config.mjs\n/hooks/use-mobile.ts\n/lib/utils.ts\n/metadata.json\n/next-env.d.ts\n/next.config.ts\n/package.json\n/postcss.config.mjs\n/tsconfig.json\n\nThe following dependencies are installed:\n@google/genai: ^2.4.0\n@hookform/resolvers: ^5.2.1\nautoprefixer: ^10.4.21\nclass-variance-authority: ^0.7.1\nclsx: ^2.1.1\nframer-motion: ^13.1.1\nlenis: ^1.3.26\nlottie-react: ^3.1.0\nlucide-react: ^0.553.0\nmotion: ^12.23.24\nnext: ^15.4.9\npostcss: ^8.5.6\nreact: ^19.2.1\nreact-dom: ^19.2.1\nreact-intersection-observer: ^11.0.0\ntailwind-merge: ^3.3.1\n\nThe following devDependencies are installed:\n@tailwindcss/postcss: 4.1.11\n@tailwindcss/typography: ^0.5.19\n@types/node: ^20\n@types/react: ^19\n@types/react-dom: ^19\neslint: 9.39.1\neslint-config-next: 16.0.8\nfirebase-tools: ^15.0.0\ntailwindcss: 4.1.11\ntw-animate-css: ^1.4.0\ntypescript: 5.9.3\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /app/about/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { Reveal } from \'@/components/ui/Reveal\';\nimport { ArrowRight } from \'lucide-react\';\n\nexport default function AboutPage() {\n  const principles = [\n    {\n      title: \'Clart\303\251\',\n      description: \'Pas de jargon technique derri\303\250re lequel se cacher. Seulement des progr\303\250s transparents et des conseils honn\303\252tes. Nous traduisons l\\\'ing\303\251nierie complexe en r\303\251sultats commerciaux clairs.\'\n    },\n    {\n      title: \'Qualit\303\251\',\n      description: \'Nous refusons de livrer un travail m\303\251diocre. Chaque pixel, chaque interaction et chaque ligne de code sont m\303\251ticuleusement con\303\247us pour r\303\251pondre \303\240 un objectif pr\303\251cis.\'\n    },\n    {\n      title: \'Transparence\',\n      description: \'Une visibilit\303\251 totale sur notre processus, nos tarifs et nos d\303\251lais. Vous ne vous demanderez jamais quel est le statut de votre projet ou la logique derri\303\250re nos d\303\251cisions.\'\n    },\n    {\n      title: \'Fiabilit\303\251\',\n      description: \'Nous livrons ce que nous promettons, quand nous le promettons. Nous consid\303\251rons nos engagements comme une architecture absolue, pas comme des suggestions flexibles.\'\n    },\n    {\n      title: \'Am\303\251lioration continue\',\n      description: \'Le lancement n\\\'est que le point de d\303\251part. Nous concevons des plateformes num\303\251riques sp\303\251cifiquement con\303\247ues pour \303\251voluer, s\\\'adapter et r\303\251pondre aux \303\251volutions du march\303\251.\'\n    }\n  ];\n\n  return (\n    <div className=\"flex flex-col w-full bg-background\">\n      {/* HERO SECTION */}\n      <section className=\"pt-48 pb-24 px-6 md:px-12 text-foreground\">\n        <div className=\"max-w-7xl mx-auto w-full\">\n          <Reveal>\n            <h1 className=\"text-4xl md:text-6xl lg:text-7xl font-serif leading-[1.05] mb-8 text-balance tracking-tight max-w-4xl\">\n              La technologie doit r\303\251soudre des probl\303\250mes, non <span className=\"italic font-light\">en cr\303\251er de nouveaux.</span>\n            </h1>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed\">\n              Nous sommes une agence digitale fond\303\251e sur la conviction qu&apos;une ing\303\251nierie exceptionnelle et un design pr\303\251cis sont les fondements ultimes de la croissance des entreprises.\n            </p>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* ATMOSPHERIC IMAGE */}\n      <section className=\"py-12 px-6 md:px-12\">\n        <div className=\"max-w-7xl mx-auto\">\n          <Reveal delay={0.2} className=\"w-full\">\n            <div className=\"relative aspect-[16/9] md:aspect-[21/9] w-full bg-muted overflow-hidden\">\n              <Image \n                src=\"https://picsum.photos/seed/Dunamis-about-office/1920/800\"\n                alt=\"Notre espace de travail collaboratif\"\n                fill\n                className=\"object-cover grayscale opacity-90\"\n                sizes=\"100vw\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* THE MISSION */}\n      <section className=\"py-24 md:py-32 px-6 md:px-12 border-b border-border\">\n        <div className=\"max-w-7xl mx-auto\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24\">\n            <div className=\"lg:col-span-4\">\n              <Reveal>\n                <h2 className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground\">\n                  Notre Mission\n                </h2>\n              </Reveal>\n            </div>\n            <div className=\"lg:col-span-8\">\n              <Reveal delay={0.1}>\n                <h3 className=\"text-3xl md:text-4xl lg:text-5xl font-serif leading-snug mb-10 text-balance\">\n                  Nous existons pour combler le foss\303\251 entre des objectifs commerciaux ambitieux et une ex\303\251cution technique sans faille.\n                </h3>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 text-muted-foreground leading-relaxed\">\n                  <p>\n                    Trop souvent, les projets digitaux \303\251chouent non pas par manque de capacit\303\251s techniques, mais \303\240 cause d&apos;une d\303\251connexion fondamentale entre la strat\303\251gie commerciale et la production digitale. Nous avons fond\303\251 cette agence pour \303\251liminer cet \303\251cart.\n                  </p>\n                  <p>\n                    Nous ne nous contentons pas d&apos;\303\251crire du code ou de pousser des pixels. Nous concevons des solutions enti\303\250rement pens\303\251es autour de vos r\303\251alit\303\251s op\303\251rationnelles, des besoins des utilisateurs et des objectifs de croissance. Nous agissons comme votre partenaire technique strat\303\251gique, bien au-del\303\240 du lancement initial.\n                  </p>\n                </div>\n              </Reveal>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* OUR PRINCIPLES */}\n      <section className=\"py-24 md:py-32 px-6 md:px-12 bg-foreground text-background\">\n        <div className=\"max-w-7xl mx-auto\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24\">\n            <div className=\"lg:col-span-4\">\n              <Reveal>\n                <h2 className=\"text-4xl md:text-5xl font-serif leading-tight\">\n                  Principes <br/><span className=\"italic font-light\">Directeurs.</span>\n                </h2>\n              </Reveal>\n            </div>\n            \n            <div className=\"lg:col-span-8\">\n              <div className=\"flex flex-col border-t border-background/20\">\n                {principles.map((principle, idx) => (\n                  <Reveal key={idx} delay={idx * 0.1}>\n                    <div className=\"py-8 md:py-12 border-b border-background/20 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-12\">\n                      <div className=\"md:col-span-1\">\n                        <h3 className=\"text-xl font-medium tracking-tight\">\n                          {principle.title}\n                        </h3>\n                      </div>\n                      <div className=\"md:col-span-2\">\n                        <p className=\"text-background/70 leading-relaxed text-base\">\n                          {principle.description}\n                        </p>\n                      </div>\n                    </div>\n                  </Reveal>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* TEAM STATEMENT */}\n      <section className=\"py-32 px-6 md:px-12 bg-muted/30\">\n        <div className=\"max-w-4xl mx-auto text-center flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-3xl md:text-4xl font-serif mb-8 text-balance\">\n              Petits par dessein. Concentr\303\251s par n\303\251cessit\303\251.\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-muted-foreground leading-relaxed max-w-2xl mb-12\">\n              Nous maintenons volontairement une \303\251quipe concentr\303\251e de praticiens exp\303\251riment\303\251s. Lorsque vous travaillez avec nous, vous collaborez directement avec les experts qui con\303\247oivent et d\303\251veloppent votre produit : pas de couches de gestion de compte, pas de transfert \303\240 des associ\303\251s juniors.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n             <Link \n              href=\"/work\" \n              className=\"inline-flex items-center gap-2 text-sm font-medium uppercase tracking-widest pb-1 border-b border-foreground hover:text-muted-foreground hover:border-muted-foreground transition-colors\"\n            >\n              D\303\251couvrir notre travail <ArrowRight className=\"w-4 h-4\" />\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* BOTTOM CTA */}\n      <section className=\"py-32 px-6 border-t border-border bg-background text-foreground text-center\">\n        <div className=\"max-w-3xl mx-auto flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-4xl md:text-5xl lg:text-7xl font-serif mb-8 text-balance\">\n              Construisons quelque chose de <span className=\"italic font-light\">durable.</span>\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n             <p className=\"text-lg text-muted-foreground mb-12 leading-relaxed max-w-xl text-center\">\n              Nous acceptons actuellement de nouveaux projets pour le T3. Contactez-nous pour r\303\251server une session strat\303\251gique.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n            <Link \n              href=\"/contact\" \n              className=\"inline-flex items-center justify-center px-10 py-5 text-sm font-medium text-background bg-foreground hover:bg-foreground/90 transition-colors uppercase tracking-widest rounded-none\"\n            >\n              Contacter l&apos;\303\251quipe\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n    </div>\n  );\n}\n\n```\n\n--- /app/contact/page.tsx ---\n```typescript\n\'use client\';\n\nimport { useState } from \'react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\nimport { ArrowRight, CheckCircle2, AlertCircle } from \'lucide-react\';\n\nexport default function ContactPage() {\n  const [formState, setFormState] = useState<\'idle\' | \'submitting\' | \'success\' | \'error\'>(\'idle\');\n\n  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {\n    e.preventDefault();\n    setFormState(\'submitting\');\n    \n    // Simulate network request\n    setTimeout(() => {\n      // In a real app, you would handle the fetch request to your API here\n      setFormState(\'success\');\n    }, 1500);\n  };\n\n  return (\n    <div className=\"flex flex-col w-full bg-background min-h-screen pt-32 pb-24\">\n      <div className=\"max-w-7xl mx-auto w-full px-6 md:px-12\">\n        \n        {/* HERO SECTION */}\n        <Reveal>\n          <div className=\"mb-20 md:mb-32\">\n            <h1 className=\"text-5xl md:text-7xl lg:text-[7rem] font-serif leading-[1] mb-8 text-balance tracking-tight\">\n              Parlons de <br /><span className=\"italic font-light\">votre projet.</span>\n            </h1>\n            <p className=\"text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed\">\n              Nous accompagnons les organisations ambitieuses pour cr\303\251er des produits digitaux g\303\251n\303\251rateurs de r\303\251sultats. Remplissez le formulaire ci-dessous et nous vous r\303\251pondrons sous 24 heures.\n            </p>\n          </div>\n        </Reveal>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24\">\n          \n          {/* CONTACT INFO (Left) */}\n          <div className=\"lg:col-span-4 flex flex-col gap-12\">\n            <Reveal delay={0.1}>\n              <div className=\"flex flex-col gap-8\">\n                <div>\n                  <h3 className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground mb-4\">Demande directe</h3>\n                  <a href=\"mailto:hello@Dunamis.com\" className=\"text-xl md:text-2xl font-serif hover:text-muted-foreground transition-colors\">\n                    hello@Dunamis.com\n                  </a>\n                </div>\n                \n                <div>\n                  <h3 className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground mb-4\">T\303\251l\303\251phone</h3>\n                  <a href=\"tel:+1234567890\" className=\"text-xl md:text-2xl font-serif hover:text-muted-foreground transition-colors\">\n                    +1 234 567 890\n                  </a>\n                </div>\n                \n                <div>\n                  <h3 className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground mb-4\">Bureaux</h3>\n                  <address className=\"text-xl md:text-2xl font-serif not-italic text-foreground\">\n                    123 Digital Ave<br />\n                    Tech District<br />\n                    NY 10001\n                  </address>\n                </div>\n              </div>\n            </Reveal>\n          </div>\n\n          {/* FORM (Right) */}\n          <div className=\"lg:col-span-8\">\n            <Reveal delay={0.2} className=\"w-full\">\n              {formState === \'success\' ? (\n                <div className=\"bg-muted p-12 flex flex-col items-center justify-center text-center h-full min-h-[400px]\">\n                  <CheckCircle2 className=\"w-12 h-12 mb-6 text-foreground\" />\n                  <h3 className=\"text-3xl font-serif mb-4\">Demande re\303\247ue</h3>\n                  <p className=\"text-muted-foreground max-w-md\">\n                    Merci de nous avoir contact\303\251s. Nous avons bien re\303\247u les d\303\251tails de votre projet et un directeur vous recontactera sous 24 heures pour discuter des prochaines \303\251tapes.\n                  </p>\n                </div>\n              ) : (\n                <form onSubmit={handleSubmit} className=\"flex flex-col gap-10\">\n                  \n                  {formState === \'error\' && (\n                    <div className=\"p-4 bg-red-50 text-red-900 border border-red-200 flex items-start gap-3\">\n                      <AlertCircle className=\"w-5 h-5 shrink-0 mt-0.5\" />\n                      <p className=\"text-sm\">Une erreur s&apos;est produite lors de l&apos;envoi. Veuillez r\303\251essayer ou nous envoyer un email directement.</p>\n                    </div>\n                  )}\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"name\" className=\"text-sm font-medium\">Nom complet *</label>\n                      <input \n                        type=\"text\" \n                        id=\"name\" \n                        required\n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50\"\n                        placeholder=\"Jane Doe\"\n                      />\n                    </div>\n                    \n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"company\" className=\"text-sm font-medium\">Entreprise</label>\n                      <input \n                        type=\"text\" \n                        id=\"company\" \n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50\"\n                        placeholder=\"Organization Name\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"email\" className=\"text-sm font-medium\">Adresse email *</label>\n                      <input \n                        type=\"email\" \n                        id=\"email\" \n                        required\n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50\"\n                        placeholder=\"jane@company.com\"\n                      />\n                    </div>\n                    \n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"phone\" className=\"text-sm font-medium\">Num\303\251ro de t\303\251l\303\251phone</label>\n                      <input \n                        type=\"tel\" \n                        id=\"phone\" \n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50\"\n                        placeholder=\"+1 (555) 000-0000\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"service\" className=\"text-sm font-medium\">Service requis *</label>\n                      <select \n                        id=\"service\" \n                        required\n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none text-foreground appearance-none cursor-pointer\"\n                        defaultValue=\"\"\n                      >\n                        <option value=\"\" disabled className=\"text-muted-foreground\">S\303\251lectionner un service</option>\n                        <option value=\"web\">D\303\251veloppement Web</option>\n                        <option value=\"mobile\">D\303\251veloppement Mobile</option>\n                        <option value=\"design\">Design & Identit\303\251</option>\n                        <option value=\"consulting\">Conseil Digital</option>\n                        <option value=\"multiple\">Multiples / Ind\303\251cis</option>\n                      </select>\n                    </div>\n                    \n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"budget\" className=\"text-sm font-medium\">Budget du projet</label>\n                      <select \n                        id=\"budget\" \n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none text-foreground appearance-none cursor-pointer\"\n                        defaultValue=\"\"\n                      >\n                        <option value=\"\" disabled className=\"text-muted-foreground\">S\303\251lectionner une fourchette</option>\n                        <option value=\"small\">Moins de 10 000 \342\202\254</option>\n                        <option value=\"medium\">10 000 \342\202\254 - 25 000 \342\202\254</option>\n                        <option value=\"large\">25 000 \342\202\254 - 50 000 \342\202\254</option>\n                        <option value=\"enterprise\">50 000 \342\202\254 et plus</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  <div className=\"flex flex-col gap-2\">\n                    <label htmlFor=\"message\" className=\"text-sm font-medium\">D\303\251tails du projet *</label>\n                    <textarea \n                      id=\"message\" \n                      required\n                      rows={5}\n                      className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50 resize-y\"\n                      placeholder=\"Parlez-nous de vos objectifs, de vos d\303\251lais et des d\303\251fis sp\303\251cifiques que vous rencontrez.\"\n                    ></textarea>\n                  </div>\n\n                  <div className=\"pt-4 flex flex-col sm:flex-row items-center gap-6 justify-between\">\n                    <p className=\"text-xs text-muted-foreground max-w-sm\">\n                      En soumettant ce formulaire, vous acceptez notre politique de confidentialit\303\251 et nos conditions d&apos;utilisation.\n                    </p>\n                    \n                    <button \n                      type=\"submit\" \n                      disabled={formState === \'submitting\'}\n                      className=\"w-full sm:w-auto inline-flex items-center justify-center gap-3 px-10 py-5 text-sm font-medium text-background bg-foreground hover:bg-foreground/90 transition-colors uppercase tracking-widest rounded-none disabled:opacity-70 disabled:cursor-not-allowed shrink-0\"\n                    >\n                      {formState === \'submitting\' ? (\n                        \'Envoi en cours...\'\n                      ) : (\n                        <>\n                          Envoyer la demande <ArrowRight className=\"w-4 h-4\" />\n                        </>\n                      )}\n                    </button>\n                  </div>\n\n... (truncated)\n```\n\n--- /app/globals.css ---\n```css\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  --font-serif: ui-serif, Georgia, Cambria, \"Times New Roman\", Times, serif;\n\n  --color-background: #FAFAFA;\n  --color-foreground: #111111;\n  --color-muted: #F2F2F2;\n  --color-muted-foreground: #666666;\n  \n  --color-primary: #111111;\n  --color-primary-foreground: #FFFFFF;\n  \n  --color-border: #E5E5E5;\n  --color-card: #FFFFFF;\n  --color-card-foreground: #111111;\n  \n  --color-accent: #2A3B4C;\n}\n\n@layer base {\n  :root {\n    --background: #FAFAFA;\n    --foreground: #111111;\n    --muted: #F2F2F2;\n    --muted-foreground: #666666;\n    --primary: #111111;\n    --primary-foreground: #FFFFFF;\n    --border: #E5E5E5;\n    --card: #FFFFFF;\n    --card-foreground: #111111;\n    --accent: #2A3B4C;\n  }\n\n  body {\n    @apply bg-background text-foreground font-sans antialiased selection:bg-primary selection:text-primary-foreground;\n  }\n\n  h1, h2, h3, h4, h5, h6 {\n    @apply font-serif tracking-tight text-balance;\n  }\n\n  /* Lenis smooth scrolling base styles */\n  html.lenis, html.lenis body {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n  .lenis.lenis-scrolling iframe {\n    pointer-events: none;\n  }\n}\n\n```\n\n--- /app/layout.tsx ---\n```typescript\nimport type {Metadata} from \'next\';\nimport \'./globals.css\';\nimport SmoothScrolling from \'@/components/layout/SmoothScrolling\';\nimport Navbar from \'@/components/layout/Navbar\';\nimport Footer from \'@/components/layout/Footer\';\n\nexport const metadata: Metadata = {\n  title: \'Agence Digitale | Solutions Modernes\',\n  description: \'Solutions digitales pour les entreprises ambitieuses.\',\n};\n\nexport default function RootLayout({children}: {children: React.ReactNode}) {\n  return (\n    <html lang=\"fr\">\n      <body suppressHydrationWarning className=\"min-h-screen flex flex-col selection:bg-foreground selection:text-background\">\n        <SmoothScrolling>\n          <Navbar />\n          <main className=\"flex-grow\">\n            {children}\n          </main>\n          <Footer />\n        </SmoothScrolling>\n      </body>\n    </html>\n  );\n}\n\n```\n\n--- /app/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { ArrowUpRight, CheckCircle2, ChevronDown, Monitor, Smartphone, PenTool, Lightbulb, ArrowRight, PlayCircle } from \'lucide-react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\nimport { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\nexport default function Home() {\n  const [activeFaq, setActiveFaq] = useState<number | null>(0);\n\n  const toggleFaq = (index: number) => {\n    setActiveFaq(activeFaq === index ? null : index);\n  };\n\n  return (\n    <div className=\"flex flex-col w-full\">\n      {/* SECTION 1 \342\200\224 HERO */}\n      <section className=\"relative min-h-[90vh] flex flex-col justify-end pb-24 pt-32 px-6 overflow-hidden bg-foreground text-background\">\n        <div className=\"absolute inset-0 z-0\">\n          <Image \n            src=\"https://picsum.photos/seed/Dunamis-hero-full/1920/1080\"\n            alt=\"Atmospheric architecture\"\n            fill\n            className=\"object-cover opacity-60 mix-blend-overlay\"\n            sizes=\"100vw\"\n            referrerPolicy=\"no-referrer\"\n            priority\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-t from-foreground via-foreground/60 to-transparent\"></div>\n        </div>\n        \n        <div className=\"max-w-7xl mx-auto w-full relative z-10 flex flex-col items-center text-center\">\n          <Reveal delay={0.1}>\n            <h1 className=\"text-5xl md:text-8xl lg:text-[7rem] font-serif leading-[1.05] mb-8 text-balance max-w-5xl mx-auto tracking-tight\">\n              Con\303\247u pour faire <span className=\"italic font-light\">avancer votre entreprise.</span>\n            </h1>\n          </Reveal>\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-16 w-full max-w-5xl items-end mt-12 text-left\">\n            <Reveal delay={0.2} direction=\"up\" className=\"md:col-span-1\">\n              <p className=\"text-sm font-medium uppercase tracking-widest text-background/60 mb-2\">01 / L&apos;Agence</p>\n              <p className=\"text-base text-background/80 leading-relaxed\">\n                Produits et plateformes num\303\251riques con\303\247us pour la cr\303\251dibilit\303\251, la performance et une croissance ind\303\251niable.\n              </p>\n            </Reveal>\n            \n            <Reveal delay={0.3} direction=\"up\" className=\"md:col-span-1 md:col-start-3 flex justify-end\">\n              <Link \n                href=\"/contact\" \n                className=\"inline-flex items-center justify-center px-8 py-4 text-sm font-medium text-foreground bg-background hover:bg-muted transition-colors rounded-none\"\n              >\n                D\303\251marrer un projet\n              </Link>\n            </Reveal>\n          </div>\n        </div>\n      </section>\n\n      {/* SECTION 2 \342\200\224 TRUST BAR */}\n      <section className=\"py-12 border-y border-border bg-background\">\n        <div className=\"max-w-7xl mx-auto px-6\">\n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12\">\n            <Reveal delay={0.1} direction=\"up\">\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-3xl md:text-4xl font-serif text-foreground\">30+</span>\n                <span className=\"text-sm font-medium text-muted-foreground\">Projets Livr\303\251s</span>\n              </div>\n            </Reveal>\n            <Reveal delay={0.2} direction=\"up\">\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-3xl md:text-4xl font-serif text-foreground\">15+</span>\n                <span className=\"text-sm font-medium text-muted-foreground\">Entreprises Accompagn\303\251es</span>\n              </div>\n            </Reveal>\n            <Reveal delay={0.3} direction=\"up\">\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-3xl md:text-4xl font-serif text-foreground\">5+</span>\n                <span className=\"text-sm font-medium text-muted-foreground\">Industries</span>\n              </div>\n            </Reveal>\n            <Reveal delay={0.4} direction=\"up\">\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-3xl md:text-4xl font-serif text-foreground\">100%</span>\n                <span className=\"text-sm font-medium text-muted-foreground\">Focus Client</span>\n              </div>\n            </Reveal>\n          </div>\n        </div>\n      </section>\n\n      {/* SECTION 3 \342\200\224 PROBLEM */}\n      <section className=\"py-24 md:py-32 px-6 bg-muted\">\n        <div className=\"max-w-4xl mx-auto text-center\">\n          <Reveal>\n            <h2 className=\"text-3xl md:text-5xl font-serif mb-8 text-balance\">\n              Votre entreprise m\303\251rite plus qu&apos;un simple site web.\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-muted-foreground leading-relaxed mb-16\">\n              Une pr\303\251sence en ligne obsol\303\250te, une exp\303\251rience utilisateur confuse et des performances lentes ne font pas que donner une mauvaise image, elles font fuir des clients potentiels. Une pr\303\251sence num\303\251rique professionnelle n&apos;est pas une d\303\251pense ; c&apos;est la base de la cr\303\251dibilit\303\251 moderne.\n            </p>\n          </Reveal>\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-px bg-border\">\n            <Reveal delay={0.2} direction=\"up\" className=\"bg-muted p-8 md:p-12 text-left h-full\">\n              <div className=\"text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6\">L&apos;Approche G\303\251n\303\251rique</div>\n              <ul className=\"flex flex-col gap-4\">\n                <li className=\"flex items-start gap-3 text-muted-foreground\"><span className=\"text-foreground mt-1\">\342\200\242</span> Difficile \303\240 naviguer et les mises \303\240 jour sont p\303\251nibles.</li>\n                <li className=\"flex items-start gap-3 text-muted-foreground\"><span className=\"text-foreground mt-1\">\342\200\242</span> Mauvaise exp\303\251rience mobile qui fait fuir les utilisateurs.</li>\n                <li className=\"flex items-start gap-3 text-muted-foreground\"><span className=\"text-foreground mt-1\">\342\200\242</span> Faible cr\303\251dibilit\303\251 qui profite \303\240 vos concurrents.</li>\n              </ul>\n            </Reveal>\n            <Reveal delay={0.3} direction=\"up\" className=\"bg-foreground text-background p-8 md:p-12 text-left h-full\">\n              <div className=\"text-sm font-medium text-muted uppercase tracking-widest mb-6\">Le Standard de l&apos;Agence</div>\n              <ul className=\"flex flex-col gap-4\">\n                <li className=\"flex items-start gap-3\"><CheckCircle2 className=\"w-5 h-5 mt-0.5 opacity-80 shrink-0\" /> Solutions sur mesure align\303\251es avec vos objectifs commerciaux.</li>\n                <li className=\"flex items-start gap-3\"><CheckCircle2 className=\"w-5 h-5 mt-0.5 opacity-80 shrink-0\" /> Fluide, rapide et accessible sur tous les appareils.</li>\n                <li className=\"flex items-start gap-3\"><CheckCircle2 className=\"w-5 h-5 mt-0.5 opacity-80 shrink-0\" /> Un design qui impose l&apos;autorit\303\251 et instaure la confiance.</li>\n              </ul>\n            </Reveal>\n          </div>\n        </div>\n      </section>\n\n      {/* SECTION 4 \342\200\224 SERVICES */}\n      <section className=\"py-24 md:py-32 px-6\">\n        <div className=\"max-w-7xl mx-auto\">\n          <Reveal>\n            <div className=\"mb-16 md:mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8\">\n              <div className=\"max-w-2xl\">\n                <h2 className=\"text-4xl md:text-5xl font-serif mb-6 text-balance\">\n                  Tout ce dont vous avez besoin pour construire une pr\303\251sence num\303\251rique plus forte.\n                </h2>\n                <p className=\"text-lg text-muted-foreground\">\n                  Des comp\303\251tences sp\303\251cialis\303\251es con\303\247ues pour fonctionner ensemble, offrant des solutions compl\303\250tes de la strat\303\251gie au d\303\251ploiement.\n                </p>\n              </div>\n              <Link href=\"/services\" className=\"inline-flex items-center gap-2 text-sm font-medium group pb-1 border-b border-foreground\">\n                Voir tous les services <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </Link>\n            </div>\n          </Reveal>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            <Reveal delay={0.1}>\n              <div className=\"group p-8 md:p-10 border border-border hover:border-foreground transition-colors h-full flex flex-col bg-background\">\n                <div className=\"w-12 h-12 mb-8 flex items-center justify-center bg-muted\">\n                  <Monitor className=\"w-6 h-6 text-foreground\" />\n                </div>\n                <h3 className=\"text-2xl font-serif mb-4\">D\303\251veloppement Web</h3>\n                <p className=\"text-muted-foreground mb-8 flex-grow\">\n                  Sites d&apos;entreprise, landing pages de performance, e-commerce \303\251volutif et applications web sur mesure con\303\247ues pour la vitesse et la fiabilit\303\251.\n                </p>\n                <Link href=\"/services/web\" className=\"inline-flex items-center gap-2 text-sm font-medium mt-auto group-hover:text-muted-foreground transition-colors\">\n                  En savoir plus <ArrowRight className=\"w-4 h-4\" />\n                </Link>\n              </div>\n            </Reveal>\n\n            <Reveal delay={0.2}>\n              <div className=\"group p-8 md:p-10 border border-border hover:border-foreground transition-colors h-full flex flex-col bg-background\">\n                <div className=\"w-12 h-12 mb-8 flex items-center justify-center bg-muted\">\n                  <Smartphone className=\"w-6 h-6 text-foreground\" />\n                </div>\n                <h3 className=\"text-2xl font-serif mb-4\">D\303\251veloppement Mobile</h3>\n                <p className=\"text-muted-foreground mb-8 flex-grow\">\n                  Applications m\303\251tiers natives et multiplateformes con\303\247ues pour les utilisateurs modernes. Nous transformons des flux de travail complexes en exp\303\251riences mobiles intuitives.\n                </p>\n                <Link href=\"/services/mobile\" className=\"inline-flex items-center gap-2 text-sm font-medium mt-auto group-hover:text-muted-foreground transition-colors\">\n                  En savoir plus <ArrowRight className=\"w-4 h-4\" />\n                </Link>\n              </div>\n            </Reveal>\n\n            <Reveal delay={0.1}>\n              <div className=\"group p-8 md:p-10 border border-border hover:border-foreground transition-colors h-full flex flex-col bg-background\">\n                <div className=\"w-12 h-12 mb-8 flex items-center justify-center bg-muted\">\n                  <PenTool className=\"w-6 h-6 text-foreground\" />\n                </div>\n                <h3 className=\"text-2xl font-serif mb-4\">Design & Supports</h3>\n                <p className=\"text-muted-foreground mb-8 flex-grow\">\n                  Communication visuelle professionnelle pour vos campagnes et votre entreprise. Des cr\303\251ations percutantes pour les r\303\251seaux sociaux aux identit\303\251s visuelles compl\303\250tes.\n                </p>\n                <Link href=\"/services/design\" className=\"inline-flex items-center gap-2 text-sm font-medium mt-auto group-hover:text-muted-foreground transition-colors\">\n                  En savoir plus <ArrowRight className=\"w-4 h-4\" />\n                </Link>\n              </div>\n            </Reveal>\n\n            <Reveal delay={0.2}>\n              <div className=\"group p-8 md:p-10 border border-border hover:border-foreground transition-colors h-full flex flex-col bg-background\">\n                <div className=\"w-12 h-12 mb-8 flex items-center justify-center bg-muted\">\n                  <Lightbulb className=\"w-6 h-6 text-foreground\" />\n                </div>\n                <h3 className=\"text-2xl font-serif mb-4\">Conseil Digital</h3>\n                <p className=\"text-muted-foreground mb-8 flex-grow\">\n                  Strat\303\251gie, audits UX, transformation num\303\251rique et accompagnement technique pour garantir que vos investissements sont align\303\251s avec vos objectifs commerciaux.\n... (truncated)\n```\n\n--- /app/resources/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { ArrowUpRight } from \'lucide-react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\n\nconst articles = [\n  {\n    id: \'1\',\n    title: \'Le ROI de l\\\'accessibilit\303\251 dans les applications web modernes.\',\n    excerpt: \'L\\\'accessibilit\303\251 est souvent trait\303\251e comme une simple case \303\240 cocher. Nous explorons comment le design inclusif impacte directement les taux de conversion, le SEO et le march\303\251 total adressable.\',\n    category: \'UX/UI\',\n    date: \'12 Ao\303\273t 2026\',\n    readTime: \'6 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-1/1200/800\',\n    href: \'/resources/roi-of-accessibility\'\n  },\n  {\n    id: \'2\',\n    title: \'Pourquoi votre prochain site d\\\'entreprise ne devrait pas utiliser de Page Builder.\',\n    excerpt: \'Les co\303\273ts cach\303\251s des constructeurs visuels dans les environnements d\\\'entreprise, de la d\303\251gradation des performances \303\240 l\\\'architecture non \303\251volutive et \303\240 la dette technique.\',\n    category: \'D\303\251veloppement Web\',\n    date: \'28 Juil 2026\',\n    readTime: \'8 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-2/1200/800\',\n    href: \'/resources/page-builders-hidden-costs\'\n  },\n  {\n    id: \'3\',\n    title: \'Faire le pont entre la strat\303\251gie de marque et l\\\'ex\303\251cution num\303\251rique.\',\n    excerpt: \'Une belle charte graphique est inutile si elle ne peut pas \303\252tre traduite syst\303\251matiquement en une interface num\303\251rique fonctionnelle et performante.\',\n    category: \'Strat\303\251gie Digitale\',\n    date: \'15 Juin 2026\',\n    readTime: \'5 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-3/1200/800\',\n    href: \'/resources/brand-strategy-digital-execution\'\n  },\n  {\n    id: \'4\',\n    title: \'Le Contexte d\\\'Abord est le nouveau standard de l\\\'UX Mobile.\',\n    excerpt: \'Le design mobile-first n\\\'est plus suffisant. Les utilisateurs modernes exigent des interfaces sensibles au contexte qui s\\\'adaptent \303\240 leur environnement imm\303\251diat et \303\240 leurs intentions.\',\n    category: \'Design\',\n    date: \'04 Mai 2026\',\n    readTime: \'7 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-4/1200/800\',\n    href: \'/resources/context-first-mobile-ux\'\n  },\n  {\n    id: \'5\',\n    title: \'La dette technique comme passif commercial.\',\n    excerpt: \'Comment les d\303\251cisions techniques diff\303\251r\303\251es se cumulent au fil du temps, ralentissant la vitesse de d\303\251veloppement des fonctionnalit\303\251s et augmentant les co\303\273ts d\\\'infrastructure.\',\n    category: \'Business\',\n    date: \'22 Avr 2026\',\n    readTime: \'10 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-5/1200/800\',\n    href: \'/resources/technical-debt-liability\'\n  },\n  {\n    id: \'6\',\n    title: \'Plaidoyer pour les interfaces monochromatiques dans le SaaS B2B.\',\n    excerpt: \'Pourquoi la suppression des palettes de couleurs satur\303\251es peut en r\303\251alit\303\251 am\303\251liorer la compr\303\251hension des donn\303\251es et r\303\251duire la charge cognitive pour les utilisateurs professionnels.\',\n    category: \'UX/UI\',\n    date: \'10 Mar 2026\',\n    readTime: \'4 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-6/1200/800\',\n    href: \'/resources/monochromatic-b2b-saas\'\n  }\n];\n\nexport default function ResourcesPage() {\n  return (\n    <div className=\"flex flex-col w-full bg-background\">\n      {/* HERO SECTION */}\n      <section className=\"pt-48 pb-24 px-6 md:px-12 text-foreground border-b border-border\">\n        <div className=\"max-w-7xl mx-auto w-full flex flex-col md:flex-row md:items-end justify-between gap-12\">\n          <div className=\"max-w-3xl\">\n            <Reveal>\n              <h1 className=\"text-5xl md:text-7xl lg:text-[7rem] font-serif leading-[1] mb-8 text-balance tracking-tight\">\n                Id\303\251es & <br/><span className=\"italic font-light\">Strat\303\251gie.</span>\n              </h1>\n            </Reveal>\n            <Reveal delay={0.1}>\n              <p className=\"text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed\">\n                Perspectives sur l&apos;ing\303\251nierie, le design et le commerce num\303\251rique. Nous partageons notre m\303\251thodologie et la r\303\251flexion derri\303\250re notre travail.\n              </p>\n            </Reveal>\n          </div>\n          \n          <Reveal delay={0.2}>\n            <div className=\"flex gap-4 text-sm font-medium uppercase tracking-widest text-muted-foreground\">\n              <span className=\"text-foreground\">Tout</span>\n              <span className=\"hover:text-foreground cursor-pointer transition-colors\">Ing\303\251nierie</span>\n              <span className=\"hover:text-foreground cursor-pointer transition-colors\">Design</span>\n              <span className=\"hover:text-foreground cursor-pointer transition-colors\">Strat\303\251gie</span>\n            </div>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* ARTICLES GRID */}\n      <section className=\"py-24 px-6 md:px-12\">\n        <div className=\"max-w-7xl mx-auto w-full\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-24\">\n            {articles.map((article, idx) => (\n              <Reveal key={article.id} delay={(idx % 2) * 0.1} direction=\"up\">\n                <Link href={article.href} className=\"group flex flex-col gap-6\">\n                  {/* Image Container */}\n                  <div className=\"relative aspect-[4/3] w-full overflow-hidden bg-muted\">\n                    <Image \n                      src={article.image}\n                      alt={article.title}\n                      fill\n                      className=\"object-cover transition-transform duration-1000 group-hover:scale-105 grayscale group-hover:grayscale-0\"\n                      sizes=\"(max-width: 768px) 100vw, 50vw\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  </div>\n                  \n                  {/* Metadata */}\n                  <div className=\"flex items-center gap-3 text-xs font-medium text-muted-foreground uppercase tracking-widest\">\n                    <span className=\"text-foreground\">{article.category}</span>\n                    <span className=\"w-1 h-1 bg-border rounded-full\" />\n                    <span>{article.date}</span>\n                    <span className=\"w-1 h-1 bg-border rounded-full\" />\n                    <span>{article.readTime}</span>\n                  </div>\n                  \n                  {/* Title & Excerpt */}\n                  <div className=\"flex flex-col gap-4\">\n                    <h2 className=\"text-2xl md:text-3xl font-serif text-balance leading-snug group-hover:text-muted-foreground transition-colors\">\n                      {article.title}\n                    </h2>\n                    <p className=\"text-muted-foreground leading-relaxed\">\n                      {article.excerpt}\n                    </p>\n                  </div>\n                  \n                  {/* CTA */}\n                  <div className=\"mt-2 inline-flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-foreground\">\n                    <span className=\"pb-0.5 border-b border-foreground/30 group-hover:border-foreground transition-colors\">Lire l&apos;article</span>\n                    <ArrowUpRight className=\"w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform\" />\n                  </div>\n                </Link>\n              </Reveal>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* BOTTOM CTA */}\n      <section className=\"py-32 px-6 border-t border-border bg-foreground text-background\">\n        <div className=\"max-w-4xl mx-auto text-center flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-4xl md:text-5xl lg:text-7xl font-serif mb-8 text-balance\">\n              Pr\303\252t \303\240 appliquer ces principes ?\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-background/70 mb-12 leading-relaxed max-w-xl text-center\">\n              Discutons de la mani\303\250re dont nous pouvons cr\303\251er un avantage num\303\251rique pour votre entreprise.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n            <Link \n              href=\"/contact\" \n              className=\"inline-flex items-center justify-center px-10 py-5 text-sm font-medium text-foreground bg-background hover:bg-background/90 transition-colors uppercase tracking-widest rounded-none\"\n            >\n              D\303\251marrer un projet\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n    </div>\n  );\n}\n\n```\n\n--- /app/services/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { ArrowRight } from \'lucide-react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\n\nexport default function ServicesPage() {\n  const services = [\n    {\n      id: \'01\',\n      title: \'D\303\251veloppement Web\',\n      description: \'Sites d\\\'entreprise, landing pages, e-commerce et applications web sur mesure. Nous concevons des plateformes pens\303\251es pour la vitesse, l\\\'\303\251volutivit\303\251 et une fiabilit\303\251 incontestable.\',\n      features: [\'Sites d\\\'entreprise\', \'Landing pages\', \'E-commerce\', \'Applications web\', \'SaaS\', \'Refonte\', \'Maintenance\'],\n      cta: \'Cr\303\251er mon site\',\n      href: \'/services/web\',\n      image: \'https://picsum.photos/seed/Dunamis-web/1200/900\'\n    },\n    {\n      id: \'02\',\n      title: \'D\303\251veloppement Mobile\',\n      description: \'Applications m\303\251tiers natives et multiplateformes con\303\247ues pour les utilisateurs modernes. Transformez des flux de travail complexes en exp\303\251riences mobiles intuitives et performantes.\',\n      features: [\'Android\', \'iOS\', \'Multiplateforme\', \'Applications m\303\251tiers\', \'MVP\'],\n      cta: \'Discuter de mon application\',\n      href: \'/services/mobile\',\n      image: \'https://picsum.photos/seed/Dunamis-mobile/1200/900\'\n    },\n    {\n      id: \'03\',\n      title: \'Design\',\n      description: \'Communication visuelle professionnelle pour vos campagnes et votre entreprise. Des visuels percutants pour les r\303\251seaux sociaux aux identit\303\251s visuelles compl\303\250tes qui imposent l\\\'autorit\303\251.\',\n      features: [\'Flyers promotionnels\', \'Graphismes r\303\251seaux sociaux\', \'Cr\303\251ations publicitaires\', \'Supports de marque\'],\n      cta: \'Demander un design\',\n      href: \'/services/design\',\n      image: \'https://picsum.photos/seed/Dunamis-design/1200/900\'\n    },\n    {\n      id: \'04\',\n      title: \'Conseil\',\n      description: \'Strat\303\251gie, audits UX, transformation num\303\251rique et accompagnement technique pour garantir que vos investissements soient parfaitement align\303\251s avec vos objectifs commerciaux.\',\n      features: [\'Audit digital\', \'Audit UX\', \'Strat\303\251gie produit\', \'Conseil technique\', \'Transformation num\303\251rique\'],\n      cta: \'R\303\251server une consultation\',\n      href: \'/services/consulting\',\n      image: \'https://picsum.photos/seed/Dunamis-consulting/1200/900\'\n    }\n  ];\n\n  return (\n    <div className=\"flex flex-col w-full\">\n      {/* HERO SECTION */}\n      <section className=\"relative min-h-[60vh] flex flex-col justify-end pb-24 pt-40 px-6 overflow-hidden bg-foreground text-background\">\n        <div className=\"absolute inset-0 z-0\">\n          <Image \n            src=\"https://picsum.photos/seed/Dunamis-services-hero/1920/1080\"\n            alt=\"Atmospheric architecture\"\n            fill\n            className=\"object-cover opacity-40 mix-blend-overlay grayscale\"\n            sizes=\"100vw\"\n            referrerPolicy=\"no-referrer\"\n            priority\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-t from-foreground via-foreground/80 to-transparent\"></div>\n        </div>\n        \n        <div className=\"max-w-7xl mx-auto w-full relative z-10 flex flex-col\">\n          <Reveal>\n            <h1 className=\"text-5xl md:text-7xl lg:text-[6rem] font-serif leading-[1.05] mb-8 text-balance tracking-tight max-w-4xl\">\n              Des services num\303\251riques con\303\247us autour de votre <span className=\"italic font-light\">entreprise.</span>\n            </h1>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg md:text-xl text-background/80 max-w-2xl leading-relaxed\">\n              Nos comp\303\251tences sp\303\251cialis\303\251es peuvent \303\252tre d\303\251ploy\303\251es individuellement pour r\303\251soudre des d\303\251fis sp\303\251cifiques, ou combin\303\251es en une transformation num\303\251rique compl\303\250te de bout en bout.\n            </p>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* SERVICES LIST */}\n      <section className=\"py-32 bg-background text-foreground\">\n        <div className=\"max-w-7xl mx-auto px-6 flex flex-col gap-40\">\n          {services.map((service, idx) => (\n            <div key={service.id} className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-center\">\n              {/* Text Content */}\n              <div className={`lg:col-span-5 flex flex-col ${idx % 2 === 1 ? \'lg:order-2\' : \'lg:order-1\'}`}>\n                <Reveal direction=\"up\">\n                  <div className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground mb-6\">\n                    {service.id} \342\200\224 {service.title}\n                  </div>\n                  <h2 className=\"text-4xl md:text-5xl font-serif mb-6 text-balance\">\n                    {service.title}.\n                  </h2>\n                  <p className=\"text-lg text-muted-foreground leading-relaxed mb-10\">\n                    {service.description}\n                  </p>\n                  \n                  <div className=\"mb-12\">\n                    <ul className=\"grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-8\">\n                      {service.features.map((feature, fIdx) => (\n                        <li key={fIdx} className=\"flex items-center gap-3 text-sm font-medium\">\n                          <span className=\"w-1.5 h-1.5 bg-foreground block shrink-0\"></span>\n                          <span className=\"truncate\">{feature}</span>\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n\n                  <Link \n                    href={service.href}\n                    className=\"inline-flex items-center gap-3 text-sm font-medium group uppercase tracking-wider w-fit\"\n                  >\n                    <span className=\"pb-1 border-b border-foreground\">{service.cta}</span>\n                    <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n                  </Link>\n                </Reveal>\n              </div>\n\n              {/* Image Content */}\n              <div className={`lg:col-span-7 w-full ${idx % 2 === 1 ? \'lg:order-1\' : \'lg:order-2\'}`}>\n                <Reveal direction={idx % 2 === 1 ? \'right\' : \'left\'} delay={0.2} className=\"w-full\">\n                  <div className=\"relative aspect-[4/3] w-full bg-muted overflow-hidden\">\n                    <Image \n                      src={service.image}\n                      alt={service.title}\n                      fill\n                      className=\"object-cover transition-transform duration-700 hover:scale-105 grayscale hover:grayscale-0\"\n                      sizes=\"(max-width: 1024px) 100vw, 60vw\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  </div>\n                </Reveal>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* BOTTOM CTA */}\n      <section className=\"py-32 px-6 border-t border-border bg-muted/30\">\n        <div className=\"max-w-4xl mx-auto text-center flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-4xl md:text-5xl font-serif mb-8 text-balance\">\n              Vous ne savez pas par o\303\271 commencer ? Commen\303\247ons par le probl\303\250me.\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-muted-foreground mb-12 leading-relaxed max-w-2xl text-center\">\n              Nous aidons les entreprises ambitieuses \303\240 d\303\251terminer exactement ce qui doit \303\252tre construit, quelles technologies utiliser et comment l&apos;ex\303\251cuter sans faille.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n            <Link \n              href=\"/services/consulting\" \n              className=\"inline-flex items-center justify-center px-8 py-4 text-sm font-medium text-background bg-foreground hover:bg-foreground/90 transition-colors rounded-none\"\n            >\n              R\303\251server une consultation\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n    </div>\n  );\n}\n\n```\n\n--- /app/work/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { ArrowUpRight } from \'lucide-react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\n\nconst projects = [\n  {\n    id: \'01\',\n    client: \'Lumina\',\n    year: \'2025\',\n    category: \'E-commerce\',\n    title: \'Red\303\251finir le commerce de d\303\251tail num\303\251rique pour le luxe moderne.\',\n    image: \'https://picsum.photos/seed/Dunamis-work-1/1600/1000\',\n    href: \'/work/lumina\'\n  },\n  {\n    id: \'02\',\n    client: \'Aether Systems\',\n    year: \'2025\',\n    category: \'Plateforme SaaS\',\n    title: \'Un centre de commandement pour l\\\'infrastructure distribu\303\251e.\',\n    image: \'https://picsum.photos/seed/Dunamis-work-2/1600/1000\',\n    href: \'/work/aether\'\n  },\n  {\n    id: \'03\',\n    client: \'Vesper\',\n    year: \'2024\',\n    category: \'Mobile Natif\',\n    title: \'Le concierge personnel dans votre poche.\',\n    image: \'https://picsum.photos/seed/Dunamis-work-3/1600/1000\',\n    href: \'/work/vesper\'\n  },\n  {\n    id: \'04\',\n    client: \'Nexus Capital\',\n    year: \'2024\',\n    category: \'Web & Identit\303\251\',\n    title: \'\303\211tablir l\\\'autorit\303\251 dans la finance moderne.\',\n    image: \'https://picsum.photos/seed/Dunamis-work-4/1600/1000\',\n    href: \'/work/nexus\'\n  }\n];\n\nexport default function WorkPage() {\n  return (\n    <div className=\"flex flex-col w-full\">\n      {/* HERO SECTION */}\n      <section className=\"pt-48 pb-24 px-6 md:px-12 bg-background text-foreground\">\n        <div className=\"max-w-7xl mx-auto w-full\">\n          <Reveal>\n            <h1 className=\"text-5xl md:text-7xl lg:text-[7rem] font-serif leading-[1] mb-8 text-balance tracking-tight\">\n              R\303\251alisations <span className=\"italic font-light\">S\303\251lectionn\303\251es.</span>\n            </h1>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed\">\n              Une collection soign\303\251e de produits, de plateformes et d&apos;exp\303\251riences num\303\251riques con\303\247us pour des organisations ambitieuses.\n            </p>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* PROJECTS FEED */}\n      <section className=\"pb-32 px-6 md:px-12 bg-background text-foreground\">\n        <div className=\"max-w-7xl mx-auto w-full flex flex-col gap-24 md:gap-40\">\n          {projects.map((project, idx) => (\n            <div key={project.id} className=\"group relative flex flex-col gap-8\">\n              <Reveal direction=\"up\" className=\"w-full\">\n                <Link href={project.href} className=\"block relative aspect-[4/3] md:aspect-[16/9] w-full overflow-hidden bg-muted\">\n                  <Image \n                    src={project.image}\n                    alt={project.title}\n                    fill\n                    className=\"object-cover transition-transform duration-1000 group-hover:scale-105 grayscale group-hover:grayscale-0\"\n                    sizes=\"(max-width: 768px) 100vw, (max-width: 1280px) 90vw, 1200px\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute inset-0 bg-black/10 transition-opacity duration-500 group-hover:opacity-0\" />\n                </Link>\n              </Reveal>\n\n              <Reveal delay={0.1}>\n                <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start\">\n                  <div className=\"md:col-span-4 flex flex-col gap-1\">\n                    <h3 className=\"text-xl font-medium tracking-tight\">\n                      {project.client}\n                    </h3>\n                    <div className=\"flex items-center gap-3 text-sm text-muted-foreground uppercase tracking-wider\">\n                      <span>{project.category}</span>\n                      <span className=\"w-1 h-1 bg-border rounded-full\" />\n                      <span>{project.year}</span>\n                    </div>\n                  </div>\n                  \n                  <div className=\"md:col-span-6 flex flex-col items-start gap-6\">\n                    <p className=\"text-2xl md:text-3xl font-serif text-balance leading-snug\">\n                      {project.title}\n                    </p>\n                  </div>\n                  \n                  <div className=\"md:col-span-2 flex justify-start md:justify-end\">\n                    <Link \n                      href={project.href}\n                      className=\"inline-flex items-center gap-3 text-sm font-medium uppercase tracking-wider group-hover:text-foreground transition-colors text-muted-foreground\"\n                    >\n                      <span className=\"pb-1 border-b border-transparent group-hover:border-foreground transition-colors\">Voir l&apos;\303\251tude</span>\n                      <ArrowUpRight className=\"w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform\" />\n                    </Link>\n                  </div>\n                </div>\n              </Reveal>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* BOTTOM CTA */}\n      <section className=\"py-32 px-6 border-t border-border bg-foreground text-background\">\n        <div className=\"max-w-4xl mx-auto text-center flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-4xl md:text-5xl lg:text-7xl font-serif mb-8 text-balance\">\n              Vous avez un projet en t\303\252te ?\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-background/70 mb-12 leading-relaxed max-w-xl text-center\">\n              Nous collaborons avec des leaders avant-gardistes pour construire l&apos;avenir. Discutons de votre vision.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n            <Link \n              href=\"/contact\" \n              className=\"inline-flex items-center justify-center px-10 py-5 text-sm font-medium text-foreground bg-background hover:bg-background/90 transition-colors uppercase tracking-widest rounded-none\"\n            >\n              D\303\251marrer une conversation\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n    </div>\n  );\n}\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Digital Dunamis Website Remix\",\n  \"description\": \"A high-performing website for a professional technology Dunamis, designed with Google-level usability, Apple-level attention to detail, and a premium anti-slop aesthetic.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /next.config.ts ---\n```typescript\nimport type {NextConfig} from \'next\';\n\nconst nextConfig: NextConfig = {\n  reactStrictMode: true,\n  eslint: {\n    ignoreDuringBuilds: true,\n  },\n  typescript: {\n    ignoreBuildErrors: false,\n  },\n  // Allow access to remote image placeholder.\n  images: {\n    remotePatterns: [\n      {\n        protocol: \'https\',\n        hostname: \'picsum.photos\',\n        port: \'\',\n        pathname: \'/**\', // This allows any path under the hostname\n      },\n    ],\n  },\n  output: \'standalone\',\n  transpilePackages: [\'motion\'],\n  webpack: (config, {dev}) => {\n    // HMR is disabled in AI Studio via DISABLE_HMR env var.\n    // Do not modify\303\242\302\200\302\224file watching is disabled to prevent flickering during agent edits.\n    if (dev && process.env.DISABLE_HMR === \'true\') {\n      config.watchOptions = {\n        ignored: /.*/,\n      };\n    }\n    return config;\n  },\n};\n\nexport default nextConfig;\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2017\",\n    \"lib\": [\"dom\", \"dom.iterable\", \"esnext\"],\n    \"allowJs\": true,\n    \"skipLibCheck\": true,\n    \"strict\": true,\n    \"noEmit\": true,\n    \"esModuleInterop\": true,\n    \"module\": \"esnext\",\n    \"moduleResolution\": \"bundler\",\n    \"resolveJsonModule\": true,\n    \"isolatedModules\": true,\n    \"jsx\": \"preserve\",\n    \"incremental\": true,\n    \"plugins\": [\n      {\n        \"name\": \"next\"\n      }\n    ],\n    \"baseUrl\": \".\",\n    \"paths\": {\n      \"@/*\": [\"./*\"]\n    }\n  },\n  \"include\": [\"next-env.d.ts\", \"**/*.ts\", \"**/*.tsx\", \".next/types/**/*.ts\"],\n  \"exclude\": [\"node_modules\"]\n}\n\n```"
    items {
      text: "Here is the full initial file tree for the application:\n/.env.example\n/.eslintrc.json\n/.gitignore\n/app/about/page.tsx\n/app/contact/page.tsx\n/app/globals.css\n/app/layout.tsx\n/app/page.tsx\n/app/resources/page.tsx\n/app/services/page.tsx\n/app/work/page.tsx\n/assets/.aistudio/.gitignore\n/bun.lock\n/components/layout/Footer.tsx\n/components/layout/Navbar.tsx\n/components/layout/SmoothScrolling.tsx\n/components/ui/Reveal.tsx\n/eslint.config.mjs\n/hooks/use-mobile.ts\n/lib/utils.ts\n/metadata.json\n/next-env.d.ts\n/next.config.ts\n/package.json\n/postcss.config.mjs\n/tsconfig.json\n\nThe following dependencies are installed:\n@google/genai: ^2.4.0\n@hookform/resolvers: ^5.2.1\nautoprefixer: ^10.4.21\nclass-variance-authority: ^0.7.1\nclsx: ^2.1.1\nframer-motion: ^13.1.1\nlenis: ^1.3.26\nlottie-react: ^3.1.0\nlucide-react: ^0.553.0\nmotion: ^12.23.24\nnext: ^15.4.9\npostcss: ^8.5.6\nreact: ^19.2.1\nreact-dom: ^19.2.1\nreact-intersection-observer: ^11.0.0\ntailwind-merge: ^3.3.1\n\nThe following devDependencies are installed:\n@tailwindcss/postcss: 4.1.11\n@tailwindcss/typography: ^0.5.19\n@types/node: ^20\n@types/react: ^19\n@types/react-dom: ^19\neslint: 9.39.1\neslint-config-next: 16.0.8\nfirebase-tools: ^15.0.0\ntailwindcss: 4.1.11\ntw-animate-css: ^1.4.0\ntypescript: 5.9.3\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /app/about/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { Reveal } from \'@/components/ui/Reveal\';\nimport { ArrowRight } from \'lucide-react\';\n\nexport default function AboutPage() {\n  const principles = [\n    {\n      title: \'Clart\303\251\',\n      description: \'Pas de jargon technique derri\303\250re lequel se cacher. Seulement des progr\303\250s transparents et des conseils honn\303\252tes. Nous traduisons l\\\'ing\303\251nierie complexe en r\303\251sultats commerciaux clairs.\'\n    },\n    {\n      title: \'Qualit\303\251\',\n      description: \'Nous refusons de livrer un travail m\303\251diocre. Chaque pixel, chaque interaction et chaque ligne de code sont m\303\251ticuleusement con\303\247us pour r\303\251pondre \303\240 un objectif pr\303\251cis.\'\n    },\n    {\n      title: \'Transparence\',\n      description: \'Une visibilit\303\251 totale sur notre processus, nos tarifs et nos d\303\251lais. Vous ne vous demanderez jamais quel est le statut de votre projet ou la logique derri\303\250re nos d\303\251cisions.\'\n    },\n    {\n      title: \'Fiabilit\303\251\',\n      description: \'Nous livrons ce que nous promettons, quand nous le promettons. Nous consid\303\251rons nos engagements comme une architecture absolue, pas comme des suggestions flexibles.\'\n    },\n    {\n      title: \'Am\303\251lioration continue\',\n      description: \'Le lancement n\\\'est que le point de d\303\251part. Nous concevons des plateformes num\303\251riques sp\303\251cifiquement con\303\247ues pour \303\251voluer, s\\\'adapter et r\303\251pondre aux \303\251volutions du march\303\251.\'\n    }\n  ];\n\n  return (\n    <div className=\"flex flex-col w-full bg-background\">\n      {/* HERO SECTION */}\n      <section className=\"pt-48 pb-24 px-6 md:px-12 text-foreground\">\n        <div className=\"max-w-7xl mx-auto w-full\">\n          <Reveal>\n            <h1 className=\"text-4xl md:text-6xl lg:text-7xl font-serif leading-[1.05] mb-8 text-balance tracking-tight max-w-4xl\">\n              La technologie doit r\303\251soudre des probl\303\250mes, non <span className=\"italic font-light\">en cr\303\251er de nouveaux.</span>\n            </h1>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed\">\n              Nous sommes une agence digitale fond\303\251e sur la conviction qu&apos;une ing\303\251nierie exceptionnelle et un design pr\303\251cis sont les fondements ultimes de la croissance des entreprises.\n            </p>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* ATMOSPHERIC IMAGE */}\n      <section className=\"py-12 px-6 md:px-12\">\n        <div className=\"max-w-7xl mx-auto\">\n          <Reveal delay={0.2} className=\"w-full\">\n            <div className=\"relative aspect-[16/9] md:aspect-[21/9] w-full bg-muted overflow-hidden\">\n              <Image \n                src=\"https://picsum.photos/seed/Dunamis-about-office/1920/800\"\n                alt=\"Notre espace de travail collaboratif\"\n                fill\n                className=\"object-cover grayscale opacity-90\"\n                sizes=\"100vw\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* THE MISSION */}\n      <section className=\"py-24 md:py-32 px-6 md:px-12 border-b border-border\">\n        <div className=\"max-w-7xl mx-auto\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24\">\n            <div className=\"lg:col-span-4\">\n              <Reveal>\n                <h2 className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground\">\n                  Notre Mission\n                </h2>\n              </Reveal>\n            </div>\n            <div className=\"lg:col-span-8\">\n              <Reveal delay={0.1}>\n                <h3 className=\"text-3xl md:text-4xl lg:text-5xl font-serif leading-snug mb-10 text-balance\">\n                  Nous existons pour combler le foss\303\251 entre des objectifs commerciaux ambitieux et une ex\303\251cution technique sans faille.\n                </h3>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 text-muted-foreground leading-relaxed\">\n                  <p>\n                    Trop souvent, les projets digitaux \303\251chouent non pas par manque de capacit\303\251s techniques, mais \303\240 cause d&apos;une d\303\251connexion fondamentale entre la strat\303\251gie commerciale et la production digitale. Nous avons fond\303\251 cette agence pour \303\251liminer cet \303\251cart.\n                  </p>\n                  <p>\n                    Nous ne nous contentons pas d&apos;\303\251crire du code ou de pousser des pixels. Nous concevons des solutions enti\303\250rement pens\303\251es autour de vos r\303\251alit\303\251s op\303\251rationnelles, des besoins des utilisateurs et des objectifs de croissance. Nous agissons comme votre partenaire technique strat\303\251gique, bien au-del\303\240 du lancement initial.\n                  </p>\n                </div>\n              </Reveal>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* OUR PRINCIPLES */}\n      <section className=\"py-24 md:py-32 px-6 md:px-12 bg-foreground text-background\">\n        <div className=\"max-w-7xl mx-auto\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24\">\n            <div className=\"lg:col-span-4\">\n              <Reveal>\n                <h2 className=\"text-4xl md:text-5xl font-serif leading-tight\">\n                  Principes <br/><span className=\"italic font-light\">Directeurs.</span>\n                </h2>\n              </Reveal>\n            </div>\n            \n            <div className=\"lg:col-span-8\">\n              <div className=\"flex flex-col border-t border-background/20\">\n                {principles.map((principle, idx) => (\n                  <Reveal key={idx} delay={idx * 0.1}>\n                    <div className=\"py-8 md:py-12 border-b border-background/20 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-12\">\n                      <div className=\"md:col-span-1\">\n                        <h3 className=\"text-xl font-medium tracking-tight\">\n                          {principle.title}\n                        </h3>\n                      </div>\n                      <div className=\"md:col-span-2\">\n                        <p className=\"text-background/70 leading-relaxed text-base\">\n                          {principle.description}\n                        </p>\n                      </div>\n                    </div>\n                  </Reveal>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* TEAM STATEMENT */}\n      <section className=\"py-32 px-6 md:px-12 bg-muted/30\">\n        <div className=\"max-w-4xl mx-auto text-center flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-3xl md:text-4xl font-serif mb-8 text-balance\">\n              Petits par dessein. Concentr\303\251s par n\303\251cessit\303\251.\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-muted-foreground leading-relaxed max-w-2xl mb-12\">\n              Nous maintenons volontairement une \303\251quipe concentr\303\251e de praticiens exp\303\251riment\303\251s. Lorsque vous travaillez avec nous, vous collaborez directement avec les experts qui con\303\247oivent et d\303\251veloppent votre produit : pas de couches de gestion de compte, pas de transfert \303\240 des associ\303\251s juniors.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n             <Link \n              href=\"/work\" \n              className=\"inline-flex items-center gap-2 text-sm font-medium uppercase tracking-widest pb-1 border-b border-foreground hover:text-muted-foreground hover:border-muted-foreground transition-colors\"\n            >\n              D\303\251couvrir notre travail <ArrowRight className=\"w-4 h-4\" />\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* BOTTOM CTA */}\n      <section className=\"py-32 px-6 border-t border-border bg-background text-foreground text-center\">\n        <div className=\"max-w-3xl mx-auto flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-4xl md:text-5xl lg:text-7xl font-serif mb-8 text-balance\">\n              Construisons quelque chose de <span className=\"italic font-light\">durable.</span>\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n             <p className=\"text-lg text-muted-foreground mb-12 leading-relaxed max-w-xl text-center\">\n              Nous acceptons actuellement de nouveaux projets pour le T3. Contactez-nous pour r\303\251server une session strat\303\251gique.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n            <Link \n              href=\"/contact\" \n              className=\"inline-flex items-center justify-center px-10 py-5 text-sm font-medium text-background bg-foreground hover:bg-foreground/90 transition-colors uppercase tracking-widest rounded-none\"\n            >\n              Contacter l&apos;\303\251quipe\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n    </div>\n  );\n}\n\n```\n\n--- /app/contact/page.tsx ---\n```typescript\n\'use client\';\n\nimport { useState } from \'react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\nimport { ArrowRight, CheckCircle2, AlertCircle } from \'lucide-react\';\n\nexport default function ContactPage() {\n  const [formState, setFormState] = useState<\'idle\' | \'submitting\' | \'success\' | \'error\'>(\'idle\');\n\n  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {\n    e.preventDefault();\n    setFormState(\'submitting\');\n    \n    // Simulate network request\n    setTimeout(() => {\n      // In a real app, you would handle the fetch request to your API here\n      setFormState(\'success\');\n    }, 1500);\n  };\n\n  return (\n    <div className=\"flex flex-col w-full bg-background min-h-screen pt-32 pb-24\">\n      <div className=\"max-w-7xl mx-auto w-full px-6 md:px-12\">\n        \n        {/* HERO SECTION */}\n        <Reveal>\n          <div className=\"mb-20 md:mb-32\">\n            <h1 className=\"text-5xl md:text-7xl lg:text-[7rem] font-serif leading-[1] mb-8 text-balance tracking-tight\">\n              Parlons de <br /><span className=\"italic font-light\">votre projet.</span>\n            </h1>\n            <p className=\"text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed\">\n              Nous accompagnons les organisations ambitieuses pour cr\303\251er des produits digitaux g\303\251n\303\251rateurs de r\303\251sultats. Remplissez le formulaire ci-dessous et nous vous r\303\251pondrons sous 24 heures.\n            </p>\n          </div>\n        </Reveal>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24\">\n          \n          {/* CONTACT INFO (Left) */}\n          <div className=\"lg:col-span-4 flex flex-col gap-12\">\n            <Reveal delay={0.1}>\n              <div className=\"flex flex-col gap-8\">\n                <div>\n                  <h3 className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground mb-4\">Demande directe</h3>\n                  <a href=\"mailto:hello@Dunamis.com\" className=\"text-xl md:text-2xl font-serif hover:text-muted-foreground transition-colors\">\n                    hello@Dunamis.com\n                  </a>\n                </div>\n                \n                <div>\n                  <h3 className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground mb-4\">T\303\251l\303\251phone</h3>\n                  <a href=\"tel:+1234567890\" className=\"text-xl md:text-2xl font-serif hover:text-muted-foreground transition-colors\">\n                    +1 234 567 890\n                  </a>\n                </div>\n                \n                <div>\n                  <h3 className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground mb-4\">Bureaux</h3>\n                  <address className=\"text-xl md:text-2xl font-serif not-italic text-foreground\">\n                    123 Digital Ave<br />\n                    Tech District<br />\n                    NY 10001\n                  </address>\n                </div>\n              </div>\n            </Reveal>\n          </div>\n\n          {/* FORM (Right) */}\n          <div className=\"lg:col-span-8\">\n            <Reveal delay={0.2} className=\"w-full\">\n              {formState === \'success\' ? (\n                <div className=\"bg-muted p-12 flex flex-col items-center justify-center text-center h-full min-h-[400px]\">\n                  <CheckCircle2 className=\"w-12 h-12 mb-6 text-foreground\" />\n                  <h3 className=\"text-3xl font-serif mb-4\">Demande re\303\247ue</h3>\n                  <p className=\"text-muted-foreground max-w-md\">\n                    Merci de nous avoir contact\303\251s. Nous avons bien re\303\247u les d\303\251tails de votre projet et un directeur vous recontactera sous 24 heures pour discuter des prochaines \303\251tapes.\n                  </p>\n                </div>\n              ) : (\n                <form onSubmit={handleSubmit} className=\"flex flex-col gap-10\">\n                  \n                  {formState === \'error\' && (\n                    <div className=\"p-4 bg-red-50 text-red-900 border border-red-200 flex items-start gap-3\">\n                      <AlertCircle className=\"w-5 h-5 shrink-0 mt-0.5\" />\n                      <p className=\"text-sm\">Une erreur s&apos;est produite lors de l&apos;envoi. Veuillez r\303\251essayer ou nous envoyer un email directement.</p>\n                    </div>\n                  )}\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"name\" className=\"text-sm font-medium\">Nom complet *</label>\n                      <input \n                        type=\"text\" \n                        id=\"name\" \n                        required\n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50\"\n                        placeholder=\"Jane Doe\"\n                      />\n                    </div>\n                    \n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"company\" className=\"text-sm font-medium\">Entreprise</label>\n                      <input \n                        type=\"text\" \n                        id=\"company\" \n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50\"\n                        placeholder=\"Organization Name\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"email\" className=\"text-sm font-medium\">Adresse email *</label>\n                      <input \n                        type=\"email\" \n                        id=\"email\" \n                        required\n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50\"\n                        placeholder=\"jane@company.com\"\n                      />\n                    </div>\n                    \n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"phone\" className=\"text-sm font-medium\">Num\303\251ro de t\303\251l\303\251phone</label>\n                      <input \n                        type=\"tel\" \n                        id=\"phone\" \n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50\"\n                        placeholder=\"+1 (555) 000-0000\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"service\" className=\"text-sm font-medium\">Service requis *</label>\n                      <select \n                        id=\"service\" \n                        required\n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none text-foreground appearance-none cursor-pointer\"\n                        defaultValue=\"\"\n                      >\n                        <option value=\"\" disabled className=\"text-muted-foreground\">S\303\251lectionner un service</option>\n                        <option value=\"web\">D\303\251veloppement Web</option>\n                        <option value=\"mobile\">D\303\251veloppement Mobile</option>\n                        <option value=\"design\">Design & Identit\303\251</option>\n                        <option value=\"consulting\">Conseil Digital</option>\n                        <option value=\"multiple\">Multiples / Ind\303\251cis</option>\n                      </select>\n                    </div>\n                    \n                    <div className=\"flex flex-col gap-2\">\n                      <label htmlFor=\"budget\" className=\"text-sm font-medium\">Budget du projet</label>\n                      <select \n                        id=\"budget\" \n                        className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none text-foreground appearance-none cursor-pointer\"\n                        defaultValue=\"\"\n                      >\n                        <option value=\"\" disabled className=\"text-muted-foreground\">S\303\251lectionner une fourchette</option>\n                        <option value=\"small\">Moins de 10 000 \342\202\254</option>\n                        <option value=\"medium\">10 000 \342\202\254 - 25 000 \342\202\254</option>\n                        <option value=\"large\">25 000 \342\202\254 - 50 000 \342\202\254</option>\n                        <option value=\"enterprise\">50 000 \342\202\254 et plus</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  <div className=\"flex flex-col gap-2\">\n                    <label htmlFor=\"message\" className=\"text-sm font-medium\">D\303\251tails du projet *</label>\n                    <textarea \n                      id=\"message\" \n                      required\n                      rows={5}\n                      className=\"bg-transparent border-b border-border focus:border-foreground outline-none py-3 transition-colors rounded-none placeholder:text-muted-foreground/50 resize-y\"\n                      placeholder=\"Parlez-nous de vos objectifs, de vos d\303\251lais et des d\303\251fis sp\303\251cifiques que vous rencontrez.\"\n                    ></textarea>\n                  </div>\n\n                  <div className=\"pt-4 flex flex-col sm:flex-row items-center gap-6 justify-between\">\n                    <p className=\"text-xs text-muted-foreground max-w-sm\">\n                      En soumettant ce formulaire, vous acceptez notre politique de confidentialit\303\251 et nos conditions d&apos;utilisation.\n                    </p>\n                    \n                    <button \n                      type=\"submit\" \n                      disabled={formState === \'submitting\'}\n                      className=\"w-full sm:w-auto inline-flex items-center justify-center gap-3 px-10 py-5 text-sm font-medium text-background bg-foreground hover:bg-foreground/90 transition-colors uppercase tracking-widest rounded-none disabled:opacity-70 disabled:cursor-not-allowed shrink-0\"\n                    >\n                      {formState === \'submitting\' ? (\n                        \'Envoi en cours...\'\n                      ) : (\n                        <>\n                          Envoyer la demande <ArrowRight className=\"w-4 h-4\" />\n                        </>\n                      )}\n                    </button>\n                  </div>\n\n... (truncated)\n```\n\n--- /app/globals.css ---\n```css\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  --font-serif: ui-serif, Georgia, Cambria, \"Times New Roman\", Times, serif;\n\n  --color-background: #FAFAFA;\n  --color-foreground: #111111;\n  --color-muted: #F2F2F2;\n  --color-muted-foreground: #666666;\n  \n  --color-primary: #111111;\n  --color-primary-foreground: #FFFFFF;\n  \n  --color-border: #E5E5E5;\n  --color-card: #FFFFFF;\n  --color-card-foreground: #111111;\n  \n  --color-accent: #2A3B4C;\n}\n\n@layer base {\n  :root {\n    --background: #FAFAFA;\n    --foreground: #111111;\n    --muted: #F2F2F2;\n    --muted-foreground: #666666;\n    --primary: #111111;\n    --primary-foreground: #FFFFFF;\n    --border: #E5E5E5;\n    --card: #FFFFFF;\n    --card-foreground: #111111;\n    --accent: #2A3B4C;\n  }\n\n  body {\n    @apply bg-background text-foreground font-sans antialiased selection:bg-primary selection:text-primary-foreground;\n  }\n\n  h1, h2, h3, h4, h5, h6 {\n    @apply font-serif tracking-tight text-balance;\n  }\n\n  /* Lenis smooth scrolling base styles */\n  html.lenis, html.lenis body {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n  .lenis.lenis-scrolling iframe {\n    pointer-events: none;\n  }\n}\n\n```\n\n--- /app/layout.tsx ---\n```typescript\nimport type {Metadata} from \'next\';\nimport \'./globals.css\';\nimport SmoothScrolling from \'@/components/layout/SmoothScrolling\';\nimport Navbar from \'@/components/layout/Navbar\';\nimport Footer from \'@/components/layout/Footer\';\n\nexport const metadata: Metadata = {\n  title: \'Agence Digitale | Solutions Modernes\',\n  description: \'Solutions digitales pour les entreprises ambitieuses.\',\n};\n\nexport default function RootLayout({children}: {children: React.ReactNode}) {\n  return (\n    <html lang=\"fr\">\n      <body suppressHydrationWarning className=\"min-h-screen flex flex-col selection:bg-foreground selection:text-background\">\n        <SmoothScrolling>\n          <Navbar />\n          <main className=\"flex-grow\">\n            {children}\n          </main>\n          <Footer />\n        </SmoothScrolling>\n      </body>\n    </html>\n  );\n}\n\n```\n\n--- /app/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { ArrowUpRight, CheckCircle2, ChevronDown, Monitor, Smartphone, PenTool, Lightbulb, ArrowRight, PlayCircle } from \'lucide-react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\nimport { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\nexport default function Home() {\n  const [activeFaq, setActiveFaq] = useState<number | null>(0);\n\n  const toggleFaq = (index: number) => {\n    setActiveFaq(activeFaq === index ? null : index);\n  };\n\n  return (\n    <div className=\"flex flex-col w-full\">\n      {/* SECTION 1 \342\200\224 HERO */}\n      <section className=\"relative min-h-[90vh] flex flex-col justify-end pb-24 pt-32 px-6 overflow-hidden bg-foreground text-background\">\n        <div className=\"absolute inset-0 z-0\">\n          <Image \n            src=\"https://picsum.photos/seed/Dunamis-hero-full/1920/1080\"\n            alt=\"Atmospheric architecture\"\n            fill\n            className=\"object-cover opacity-60 mix-blend-overlay\"\n            sizes=\"100vw\"\n            referrerPolicy=\"no-referrer\"\n            priority\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-t from-foreground via-foreground/60 to-transparent\"></div>\n        </div>\n        \n        <div className=\"max-w-7xl mx-auto w-full relative z-10 flex flex-col items-center text-center\">\n          <Reveal delay={0.1}>\n            <h1 className=\"text-5xl md:text-8xl lg:text-[7rem] font-serif leading-[1.05] mb-8 text-balance max-w-5xl mx-auto tracking-tight\">\n              Con\303\247u pour faire <span className=\"italic font-light\">avancer votre entreprise.</span>\n            </h1>\n          </Reveal>\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-16 w-full max-w-5xl items-end mt-12 text-left\">\n            <Reveal delay={0.2} direction=\"up\" className=\"md:col-span-1\">\n              <p className=\"text-sm font-medium uppercase tracking-widest text-background/60 mb-2\">01 / L&apos;Agence</p>\n              <p className=\"text-base text-background/80 leading-relaxed\">\n                Produits et plateformes num\303\251riques con\303\247us pour la cr\303\251dibilit\303\251, la performance et une croissance ind\303\251niable.\n              </p>\n            </Reveal>\n            \n            <Reveal delay={0.3} direction=\"up\" className=\"md:col-span-1 md:col-start-3 flex justify-end\">\n              <Link \n                href=\"/contact\" \n                className=\"inline-flex items-center justify-center px-8 py-4 text-sm font-medium text-foreground bg-background hover:bg-muted transition-colors rounded-none\"\n              >\n                D\303\251marrer un projet\n              </Link>\n            </Reveal>\n          </div>\n        </div>\n      </section>\n\n      {/* SECTION 2 \342\200\224 TRUST BAR */}\n      <section className=\"py-12 border-y border-border bg-background\">\n        <div className=\"max-w-7xl mx-auto px-6\">\n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12\">\n            <Reveal delay={0.1} direction=\"up\">\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-3xl md:text-4xl font-serif text-foreground\">30+</span>\n                <span className=\"text-sm font-medium text-muted-foreground\">Projets Livr\303\251s</span>\n              </div>\n            </Reveal>\n            <Reveal delay={0.2} direction=\"up\">\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-3xl md:text-4xl font-serif text-foreground\">15+</span>\n                <span className=\"text-sm font-medium text-muted-foreground\">Entreprises Accompagn\303\251es</span>\n              </div>\n            </Reveal>\n            <Reveal delay={0.3} direction=\"up\">\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-3xl md:text-4xl font-serif text-foreground\">5+</span>\n                <span className=\"text-sm font-medium text-muted-foreground\">Industries</span>\n              </div>\n            </Reveal>\n            <Reveal delay={0.4} direction=\"up\">\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-3xl md:text-4xl font-serif text-foreground\">100%</span>\n                <span className=\"text-sm font-medium text-muted-foreground\">Focus Client</span>\n              </div>\n            </Reveal>\n          </div>\n        </div>\n      </section>\n\n      {/* SECTION 3 \342\200\224 PROBLEM */}\n      <section className=\"py-24 md:py-32 px-6 bg-muted\">\n        <div className=\"max-w-4xl mx-auto text-center\">\n          <Reveal>\n            <h2 className=\"text-3xl md:text-5xl font-serif mb-8 text-balance\">\n              Votre entreprise m\303\251rite plus qu&apos;un simple site web.\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-muted-foreground leading-relaxed mb-16\">\n              Une pr\303\251sence en ligne obsol\303\250te, une exp\303\251rience utilisateur confuse et des performances lentes ne font pas que donner une mauvaise image, elles font fuir des clients potentiels. Une pr\303\251sence num\303\251rique professionnelle n&apos;est pas une d\303\251pense ; c&apos;est la base de la cr\303\251dibilit\303\251 moderne.\n            </p>\n          </Reveal>\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-px bg-border\">\n            <Reveal delay={0.2} direction=\"up\" className=\"bg-muted p-8 md:p-12 text-left h-full\">\n              <div className=\"text-sm font-medium text-muted-foreground uppercase tracking-widest mb-6\">L&apos;Approche G\303\251n\303\251rique</div>\n              <ul className=\"flex flex-col gap-4\">\n                <li className=\"flex items-start gap-3 text-muted-foreground\"><span className=\"text-foreground mt-1\">\342\200\242</span> Difficile \303\240 naviguer et les mises \303\240 jour sont p\303\251nibles.</li>\n                <li className=\"flex items-start gap-3 text-muted-foreground\"><span className=\"text-foreground mt-1\">\342\200\242</span> Mauvaise exp\303\251rience mobile qui fait fuir les utilisateurs.</li>\n                <li className=\"flex items-start gap-3 text-muted-foreground\"><span className=\"text-foreground mt-1\">\342\200\242</span> Faible cr\303\251dibilit\303\251 qui profite \303\240 vos concurrents.</li>\n              </ul>\n            </Reveal>\n            <Reveal delay={0.3} direction=\"up\" className=\"bg-foreground text-background p-8 md:p-12 text-left h-full\">\n              <div className=\"text-sm font-medium text-muted uppercase tracking-widest mb-6\">Le Standard de l&apos;Agence</div>\n              <ul className=\"flex flex-col gap-4\">\n                <li className=\"flex items-start gap-3\"><CheckCircle2 className=\"w-5 h-5 mt-0.5 opacity-80 shrink-0\" /> Solutions sur mesure align\303\251es avec vos objectifs commerciaux.</li>\n                <li className=\"flex items-start gap-3\"><CheckCircle2 className=\"w-5 h-5 mt-0.5 opacity-80 shrink-0\" /> Fluide, rapide et accessible sur tous les appareils.</li>\n                <li className=\"flex items-start gap-3\"><CheckCircle2 className=\"w-5 h-5 mt-0.5 opacity-80 shrink-0\" /> Un design qui impose l&apos;autorit\303\251 et instaure la confiance.</li>\n              </ul>\n            </Reveal>\n          </div>\n        </div>\n      </section>\n\n      {/* SECTION 4 \342\200\224 SERVICES */}\n      <section className=\"py-24 md:py-32 px-6\">\n        <div className=\"max-w-7xl mx-auto\">\n          <Reveal>\n            <div className=\"mb-16 md:mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8\">\n              <div className=\"max-w-2xl\">\n                <h2 className=\"text-4xl md:text-5xl font-serif mb-6 text-balance\">\n                  Tout ce dont vous avez besoin pour construire une pr\303\251sence num\303\251rique plus forte.\n                </h2>\n                <p className=\"text-lg text-muted-foreground\">\n                  Des comp\303\251tences sp\303\251cialis\303\251es con\303\247ues pour fonctionner ensemble, offrant des solutions compl\303\250tes de la strat\303\251gie au d\303\251ploiement.\n                </p>\n              </div>\n              <Link href=\"/services\" className=\"inline-flex items-center gap-2 text-sm font-medium group pb-1 border-b border-foreground\">\n                Voir tous les services <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </Link>\n            </div>\n          </Reveal>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            <Reveal delay={0.1}>\n              <div className=\"group p-8 md:p-10 border border-border hover:border-foreground transition-colors h-full flex flex-col bg-background\">\n                <div className=\"w-12 h-12 mb-8 flex items-center justify-center bg-muted\">\n                  <Monitor className=\"w-6 h-6 text-foreground\" />\n                </div>\n                <h3 className=\"text-2xl font-serif mb-4\">D\303\251veloppement Web</h3>\n                <p className=\"text-muted-foreground mb-8 flex-grow\">\n                  Sites d&apos;entreprise, landing pages de performance, e-commerce \303\251volutif et applications web sur mesure con\303\247ues pour la vitesse et la fiabilit\303\251.\n                </p>\n                <Link href=\"/services/web\" className=\"inline-flex items-center gap-2 text-sm font-medium mt-auto group-hover:text-muted-foreground transition-colors\">\n                  En savoir plus <ArrowRight className=\"w-4 h-4\" />\n                </Link>\n              </div>\n            </Reveal>\n\n            <Reveal delay={0.2}>\n              <div className=\"group p-8 md:p-10 border border-border hover:border-foreground transition-colors h-full flex flex-col bg-background\">\n                <div className=\"w-12 h-12 mb-8 flex items-center justify-center bg-muted\">\n                  <Smartphone className=\"w-6 h-6 text-foreground\" />\n                </div>\n                <h3 className=\"text-2xl font-serif mb-4\">D\303\251veloppement Mobile</h3>\n                <p className=\"text-muted-foreground mb-8 flex-grow\">\n                  Applications m\303\251tiers natives et multiplateformes con\303\247ues pour les utilisateurs modernes. Nous transformons des flux de travail complexes en exp\303\251riences mobiles intuitives.\n                </p>\n                <Link href=\"/services/mobile\" className=\"inline-flex items-center gap-2 text-sm font-medium mt-auto group-hover:text-muted-foreground transition-colors\">\n                  En savoir plus <ArrowRight className=\"w-4 h-4\" />\n                </Link>\n              </div>\n            </Reveal>\n\n            <Reveal delay={0.1}>\n              <div className=\"group p-8 md:p-10 border border-border hover:border-foreground transition-colors h-full flex flex-col bg-background\">\n                <div className=\"w-12 h-12 mb-8 flex items-center justify-center bg-muted\">\n                  <PenTool className=\"w-6 h-6 text-foreground\" />\n                </div>\n                <h3 className=\"text-2xl font-serif mb-4\">Design & Supports</h3>\n                <p className=\"text-muted-foreground mb-8 flex-grow\">\n                  Communication visuelle professionnelle pour vos campagnes et votre entreprise. Des cr\303\251ations percutantes pour les r\303\251seaux sociaux aux identit\303\251s visuelles compl\303\250tes.\n                </p>\n                <Link href=\"/services/design\" className=\"inline-flex items-center gap-2 text-sm font-medium mt-auto group-hover:text-muted-foreground transition-colors\">\n                  En savoir plus <ArrowRight className=\"w-4 h-4\" />\n                </Link>\n              </div>\n            </Reveal>\n\n            <Reveal delay={0.2}>\n              <div className=\"group p-8 md:p-10 border border-border hover:border-foreground transition-colors h-full flex flex-col bg-background\">\n                <div className=\"w-12 h-12 mb-8 flex items-center justify-center bg-muted\">\n                  <Lightbulb className=\"w-6 h-6 text-foreground\" />\n                </div>\n                <h3 className=\"text-2xl font-serif mb-4\">Conseil Digital</h3>\n                <p className=\"text-muted-foreground mb-8 flex-grow\">\n                  Strat\303\251gie, audits UX, transformation num\303\251rique et accompagnement technique pour garantir que vos investissements sont align\303\251s avec vos objectifs commerciaux.\n... (truncated)\n```\n\n--- /app/resources/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { ArrowUpRight } from \'lucide-react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\n\nconst articles = [\n  {\n    id: \'1\',\n    title: \'Le ROI de l\\\'accessibilit\303\251 dans les applications web modernes.\',\n    excerpt: \'L\\\'accessibilit\303\251 est souvent trait\303\251e comme une simple case \303\240 cocher. Nous explorons comment le design inclusif impacte directement les taux de conversion, le SEO et le march\303\251 total adressable.\',\n    category: \'UX/UI\',\n    date: \'12 Ao\303\273t 2026\',\n    readTime: \'6 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-1/1200/800\',\n    href: \'/resources/roi-of-accessibility\'\n  },\n  {\n    id: \'2\',\n    title: \'Pourquoi votre prochain site d\\\'entreprise ne devrait pas utiliser de Page Builder.\',\n    excerpt: \'Les co\303\273ts cach\303\251s des constructeurs visuels dans les environnements d\\\'entreprise, de la d\303\251gradation des performances \303\240 l\\\'architecture non \303\251volutive et \303\240 la dette technique.\',\n    category: \'D\303\251veloppement Web\',\n    date: \'28 Juil 2026\',\n    readTime: \'8 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-2/1200/800\',\n    href: \'/resources/page-builders-hidden-costs\'\n  },\n  {\n    id: \'3\',\n    title: \'Faire le pont entre la strat\303\251gie de marque et l\\\'ex\303\251cution num\303\251rique.\',\n    excerpt: \'Une belle charte graphique est inutile si elle ne peut pas \303\252tre traduite syst\303\251matiquement en une interface num\303\251rique fonctionnelle et performante.\',\n    category: \'Strat\303\251gie Digitale\',\n    date: \'15 Juin 2026\',\n    readTime: \'5 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-3/1200/800\',\n    href: \'/resources/brand-strategy-digital-execution\'\n  },\n  {\n    id: \'4\',\n    title: \'Le Contexte d\\\'Abord est le nouveau standard de l\\\'UX Mobile.\',\n    excerpt: \'Le design mobile-first n\\\'est plus suffisant. Les utilisateurs modernes exigent des interfaces sensibles au contexte qui s\\\'adaptent \303\240 leur environnement imm\303\251diat et \303\240 leurs intentions.\',\n    category: \'Design\',\n    date: \'04 Mai 2026\',\n    readTime: \'7 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-4/1200/800\',\n    href: \'/resources/context-first-mobile-ux\'\n  },\n  {\n    id: \'5\',\n    title: \'La dette technique comme passif commercial.\',\n    excerpt: \'Comment les d\303\251cisions techniques diff\303\251r\303\251es se cumulent au fil du temps, ralentissant la vitesse de d\303\251veloppement des fonctionnalit\303\251s et augmentant les co\303\273ts d\\\'infrastructure.\',\n    category: \'Business\',\n    date: \'22 Avr 2026\',\n    readTime: \'10 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-5/1200/800\',\n    href: \'/resources/technical-debt-liability\'\n  },\n  {\n    id: \'6\',\n    title: \'Plaidoyer pour les interfaces monochromatiques dans le SaaS B2B.\',\n    excerpt: \'Pourquoi la suppression des palettes de couleurs satur\303\251es peut en r\303\251alit\303\251 am\303\251liorer la compr\303\251hension des donn\303\251es et r\303\251duire la charge cognitive pour les utilisateurs professionnels.\',\n    category: \'UX/UI\',\n    date: \'10 Mar 2026\',\n    readTime: \'4 min de lecture\',\n    image: \'https://picsum.photos/seed/Dunamis-blog-6/1200/800\',\n    href: \'/resources/monochromatic-b2b-saas\'\n  }\n];\n\nexport default function ResourcesPage() {\n  return (\n    <div className=\"flex flex-col w-full bg-background\">\n      {/* HERO SECTION */}\n      <section className=\"pt-48 pb-24 px-6 md:px-12 text-foreground border-b border-border\">\n        <div className=\"max-w-7xl mx-auto w-full flex flex-col md:flex-row md:items-end justify-between gap-12\">\n          <div className=\"max-w-3xl\">\n            <Reveal>\n              <h1 className=\"text-5xl md:text-7xl lg:text-[7rem] font-serif leading-[1] mb-8 text-balance tracking-tight\">\n                Id\303\251es & <br/><span className=\"italic font-light\">Strat\303\251gie.</span>\n              </h1>\n            </Reveal>\n            <Reveal delay={0.1}>\n              <p className=\"text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed\">\n                Perspectives sur l&apos;ing\303\251nierie, le design et le commerce num\303\251rique. Nous partageons notre m\303\251thodologie et la r\303\251flexion derri\303\250re notre travail.\n              </p>\n            </Reveal>\n          </div>\n          \n          <Reveal delay={0.2}>\n            <div className=\"flex gap-4 text-sm font-medium uppercase tracking-widest text-muted-foreground\">\n              <span className=\"text-foreground\">Tout</span>\n              <span className=\"hover:text-foreground cursor-pointer transition-colors\">Ing\303\251nierie</span>\n              <span className=\"hover:text-foreground cursor-pointer transition-colors\">Design</span>\n              <span className=\"hover:text-foreground cursor-pointer transition-colors\">Strat\303\251gie</span>\n            </div>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* ARTICLES GRID */}\n      <section className=\"py-24 px-6 md:px-12\">\n        <div className=\"max-w-7xl mx-auto w-full\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-24\">\n            {articles.map((article, idx) => (\n              <Reveal key={article.id} delay={(idx % 2) * 0.1} direction=\"up\">\n                <Link href={article.href} className=\"group flex flex-col gap-6\">\n                  {/* Image Container */}\n                  <div className=\"relative aspect-[4/3] w-full overflow-hidden bg-muted\">\n                    <Image \n                      src={article.image}\n                      alt={article.title}\n                      fill\n                      className=\"object-cover transition-transform duration-1000 group-hover:scale-105 grayscale group-hover:grayscale-0\"\n                      sizes=\"(max-width: 768px) 100vw, 50vw\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  </div>\n                  \n                  {/* Metadata */}\n                  <div className=\"flex items-center gap-3 text-xs font-medium text-muted-foreground uppercase tracking-widest\">\n                    <span className=\"text-foreground\">{article.category}</span>\n                    <span className=\"w-1 h-1 bg-border rounded-full\" />\n                    <span>{article.date}</span>\n                    <span className=\"w-1 h-1 bg-border rounded-full\" />\n                    <span>{article.readTime}</span>\n                  </div>\n                  \n                  {/* Title & Excerpt */}\n                  <div className=\"flex flex-col gap-4\">\n                    <h2 className=\"text-2xl md:text-3xl font-serif text-balance leading-snug group-hover:text-muted-foreground transition-colors\">\n                      {article.title}\n                    </h2>\n                    <p className=\"text-muted-foreground leading-relaxed\">\n                      {article.excerpt}\n                    </p>\n                  </div>\n                  \n                  {/* CTA */}\n                  <div className=\"mt-2 inline-flex items-center gap-2 text-sm font-medium uppercase tracking-wider text-foreground\">\n                    <span className=\"pb-0.5 border-b border-foreground/30 group-hover:border-foreground transition-colors\">Lire l&apos;article</span>\n                    <ArrowUpRight className=\"w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform\" />\n                  </div>\n                </Link>\n              </Reveal>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* BOTTOM CTA */}\n      <section className=\"py-32 px-6 border-t border-border bg-foreground text-background\">\n        <div className=\"max-w-4xl mx-auto text-center flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-4xl md:text-5xl lg:text-7xl font-serif mb-8 text-balance\">\n              Pr\303\252t \303\240 appliquer ces principes ?\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-background/70 mb-12 leading-relaxed max-w-xl text-center\">\n              Discutons de la mani\303\250re dont nous pouvons cr\303\251er un avantage num\303\251rique pour votre entreprise.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n            <Link \n              href=\"/contact\" \n              className=\"inline-flex items-center justify-center px-10 py-5 text-sm font-medium text-foreground bg-background hover:bg-background/90 transition-colors uppercase tracking-widest rounded-none\"\n            >\n              D\303\251marrer un projet\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n    </div>\n  );\n}\n\n```\n\n--- /app/services/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { ArrowRight } from \'lucide-react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\n\nexport default function ServicesPage() {\n  const services = [\n    {\n      id: \'01\',\n      title: \'D\303\251veloppement Web\',\n      description: \'Sites d\\\'entreprise, landing pages, e-commerce et applications web sur mesure. Nous concevons des plateformes pens\303\251es pour la vitesse, l\\\'\303\251volutivit\303\251 et une fiabilit\303\251 incontestable.\',\n      features: [\'Sites d\\\'entreprise\', \'Landing pages\', \'E-commerce\', \'Applications web\', \'SaaS\', \'Refonte\', \'Maintenance\'],\n      cta: \'Cr\303\251er mon site\',\n      href: \'/services/web\',\n      image: \'https://picsum.photos/seed/Dunamis-web/1200/900\'\n    },\n    {\n      id: \'02\',\n      title: \'D\303\251veloppement Mobile\',\n      description: \'Applications m\303\251tiers natives et multiplateformes con\303\247ues pour les utilisateurs modernes. Transformez des flux de travail complexes en exp\303\251riences mobiles intuitives et performantes.\',\n      features: [\'Android\', \'iOS\', \'Multiplateforme\', \'Applications m\303\251tiers\', \'MVP\'],\n      cta: \'Discuter de mon application\',\n      href: \'/services/mobile\',\n      image: \'https://picsum.photos/seed/Dunamis-mobile/1200/900\'\n    },\n    {\n      id: \'03\',\n      title: \'Design\',\n      description: \'Communication visuelle professionnelle pour vos campagnes et votre entreprise. Des visuels percutants pour les r\303\251seaux sociaux aux identit\303\251s visuelles compl\303\250tes qui imposent l\\\'autorit\303\251.\',\n      features: [\'Flyers promotionnels\', \'Graphismes r\303\251seaux sociaux\', \'Cr\303\251ations publicitaires\', \'Supports de marque\'],\n      cta: \'Demander un design\',\n      href: \'/services/design\',\n      image: \'https://picsum.photos/seed/Dunamis-design/1200/900\'\n    },\n    {\n      id: \'04\',\n      title: \'Conseil\',\n      description: \'Strat\303\251gie, audits UX, transformation num\303\251rique et accompagnement technique pour garantir que vos investissements soient parfaitement align\303\251s avec vos objectifs commerciaux.\',\n      features: [\'Audit digital\', \'Audit UX\', \'Strat\303\251gie produit\', \'Conseil technique\', \'Transformation num\303\251rique\'],\n      cta: \'R\303\251server une consultation\',\n      href: \'/services/consulting\',\n      image: \'https://picsum.photos/seed/Dunamis-consulting/1200/900\'\n    }\n  ];\n\n  return (\n    <div className=\"flex flex-col w-full\">\n      {/* HERO SECTION */}\n      <section className=\"relative min-h-[60vh] flex flex-col justify-end pb-24 pt-40 px-6 overflow-hidden bg-foreground text-background\">\n        <div className=\"absolute inset-0 z-0\">\n          <Image \n            src=\"https://picsum.photos/seed/Dunamis-services-hero/1920/1080\"\n            alt=\"Atmospheric architecture\"\n            fill\n            className=\"object-cover opacity-40 mix-blend-overlay grayscale\"\n            sizes=\"100vw\"\n            referrerPolicy=\"no-referrer\"\n            priority\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-t from-foreground via-foreground/80 to-transparent\"></div>\n        </div>\n        \n        <div className=\"max-w-7xl mx-auto w-full relative z-10 flex flex-col\">\n          <Reveal>\n            <h1 className=\"text-5xl md:text-7xl lg:text-[6rem] font-serif leading-[1.05] mb-8 text-balance tracking-tight max-w-4xl\">\n              Des services num\303\251riques con\303\247us autour de votre <span className=\"italic font-light\">entreprise.</span>\n            </h1>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg md:text-xl text-background/80 max-w-2xl leading-relaxed\">\n              Nos comp\303\251tences sp\303\251cialis\303\251es peuvent \303\252tre d\303\251ploy\303\251es individuellement pour r\303\251soudre des d\303\251fis sp\303\251cifiques, ou combin\303\251es en une transformation num\303\251rique compl\303\250te de bout en bout.\n            </p>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* SERVICES LIST */}\n      <section className=\"py-32 bg-background text-foreground\">\n        <div className=\"max-w-7xl mx-auto px-6 flex flex-col gap-40\">\n          {services.map((service, idx) => (\n            <div key={service.id} className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-center\">\n              {/* Text Content */}\n              <div className={`lg:col-span-5 flex flex-col ${idx % 2 === 1 ? \'lg:order-2\' : \'lg:order-1\'}`}>\n                <Reveal direction=\"up\">\n                  <div className=\"text-sm font-medium uppercase tracking-widest text-muted-foreground mb-6\">\n                    {service.id} \342\200\224 {service.title}\n                  </div>\n                  <h2 className=\"text-4xl md:text-5xl font-serif mb-6 text-balance\">\n                    {service.title}.\n                  </h2>\n                  <p className=\"text-lg text-muted-foreground leading-relaxed mb-10\">\n                    {service.description}\n                  </p>\n                  \n                  <div className=\"mb-12\">\n                    <ul className=\"grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-8\">\n                      {service.features.map((feature, fIdx) => (\n                        <li key={fIdx} className=\"flex items-center gap-3 text-sm font-medium\">\n                          <span className=\"w-1.5 h-1.5 bg-foreground block shrink-0\"></span>\n                          <span className=\"truncate\">{feature}</span>\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n\n                  <Link \n                    href={service.href}\n                    className=\"inline-flex items-center gap-3 text-sm font-medium group uppercase tracking-wider w-fit\"\n                  >\n                    <span className=\"pb-1 border-b border-foreground\">{service.cta}</span>\n                    <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n                  </Link>\n                </Reveal>\n              </div>\n\n              {/* Image Content */}\n              <div className={`lg:col-span-7 w-full ${idx % 2 === 1 ? \'lg:order-1\' : \'lg:order-2\'}`}>\n                <Reveal direction={idx % 2 === 1 ? \'right\' : \'left\'} delay={0.2} className=\"w-full\">\n                  <div className=\"relative aspect-[4/3] w-full bg-muted overflow-hidden\">\n                    <Image \n                      src={service.image}\n                      alt={service.title}\n                      fill\n                      className=\"object-cover transition-transform duration-700 hover:scale-105 grayscale hover:grayscale-0\"\n                      sizes=\"(max-width: 1024px) 100vw, 60vw\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                  </div>\n                </Reveal>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* BOTTOM CTA */}\n      <section className=\"py-32 px-6 border-t border-border bg-muted/30\">\n        <div className=\"max-w-4xl mx-auto text-center flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-4xl md:text-5xl font-serif mb-8 text-balance\">\n              Vous ne savez pas par o\303\271 commencer ? Commen\303\247ons par le probl\303\250me.\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-muted-foreground mb-12 leading-relaxed max-w-2xl text-center\">\n              Nous aidons les entreprises ambitieuses \303\240 d\303\251terminer exactement ce qui doit \303\252tre construit, quelles technologies utiliser et comment l&apos;ex\303\251cuter sans faille.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n            <Link \n              href=\"/services/consulting\" \n              className=\"inline-flex items-center justify-center px-8 py-4 text-sm font-medium text-background bg-foreground hover:bg-foreground/90 transition-colors rounded-none\"\n            >\n              R\303\251server une consultation\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n    </div>\n  );\n}\n\n```\n\n--- /app/work/page.tsx ---\n```typescript\n\'use client\';\n\nimport Link from \'next/link\';\nimport Image from \'next/image\';\nimport { ArrowUpRight } from \'lucide-react\';\nimport { Reveal } from \'@/components/ui/Reveal\';\n\nconst projects = [\n  {\n    id: \'01\',\n    client: \'Lumina\',\n    year: \'2025\',\n    category: \'E-commerce\',\n    title: \'Red\303\251finir le commerce de d\303\251tail num\303\251rique pour le luxe moderne.\',\n    image: \'https://picsum.photos/seed/Dunamis-work-1/1600/1000\',\n    href: \'/work/lumina\'\n  },\n  {\n    id: \'02\',\n    client: \'Aether Systems\',\n    year: \'2025\',\n    category: \'Plateforme SaaS\',\n    title: \'Un centre de commandement pour l\\\'infrastructure distribu\303\251e.\',\n    image: \'https://picsum.photos/seed/Dunamis-work-2/1600/1000\',\n    href: \'/work/aether\'\n  },\n  {\n    id: \'03\',\n    client: \'Vesper\',\n    year: \'2024\',\n    category: \'Mobile Natif\',\n    title: \'Le concierge personnel dans votre poche.\',\n    image: \'https://picsum.photos/seed/Dunamis-work-3/1600/1000\',\n    href: \'/work/vesper\'\n  },\n  {\n    id: \'04\',\n    client: \'Nexus Capital\',\n    year: \'2024\',\n    category: \'Web & Identit\303\251\',\n    title: \'\303\211tablir l\\\'autorit\303\251 dans la finance moderne.\',\n    image: \'https://picsum.photos/seed/Dunamis-work-4/1600/1000\',\n    href: \'/work/nexus\'\n  }\n];\n\nexport default function WorkPage() {\n  return (\n    <div className=\"flex flex-col w-full\">\n      {/* HERO SECTION */}\n      <section className=\"pt-48 pb-24 px-6 md:px-12 bg-background text-foreground\">\n        <div className=\"max-w-7xl mx-auto w-full\">\n          <Reveal>\n            <h1 className=\"text-5xl md:text-7xl lg:text-[7rem] font-serif leading-[1] mb-8 text-balance tracking-tight\">\n              R\303\251alisations <span className=\"italic font-light\">S\303\251lectionn\303\251es.</span>\n            </h1>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed\">\n              Une collection soign\303\251e de produits, de plateformes et d&apos;exp\303\251riences num\303\251riques con\303\247us pour des organisations ambitieuses.\n            </p>\n          </Reveal>\n        </div>\n      </section>\n\n      {/* PROJECTS FEED */}\n      <section className=\"pb-32 px-6 md:px-12 bg-background text-foreground\">\n        <div className=\"max-w-7xl mx-auto w-full flex flex-col gap-24 md:gap-40\">\n          {projects.map((project, idx) => (\n            <div key={project.id} className=\"group relative flex flex-col gap-8\">\n              <Reveal direction=\"up\" className=\"w-full\">\n                <Link href={project.href} className=\"block relative aspect-[4/3] md:aspect-[16/9] w-full overflow-hidden bg-muted\">\n                  <Image \n                    src={project.image}\n                    alt={project.title}\n                    fill\n                    className=\"object-cover transition-transform duration-1000 group-hover:scale-105 grayscale group-hover:grayscale-0\"\n                    sizes=\"(max-width: 768px) 100vw, (max-width: 1280px) 90vw, 1200px\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute inset-0 bg-black/10 transition-opacity duration-500 group-hover:opacity-0\" />\n                </Link>\n              </Reveal>\n\n              <Reveal delay={0.1}>\n                <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start\">\n                  <div className=\"md:col-span-4 flex flex-col gap-1\">\n                    <h3 className=\"text-xl font-medium tracking-tight\">\n                      {project.client}\n                    </h3>\n                    <div className=\"flex items-center gap-3 text-sm text-muted-foreground uppercase tracking-wider\">\n                      <span>{project.category}</span>\n                      <span className=\"w-1 h-1 bg-border rounded-full\" />\n                      <span>{project.year}</span>\n                    </div>\n                  </div>\n                  \n                  <div className=\"md:col-span-6 flex flex-col items-start gap-6\">\n                    <p className=\"text-2xl md:text-3xl font-serif text-balance leading-snug\">\n                      {project.title}\n                    </p>\n                  </div>\n                  \n                  <div className=\"md:col-span-2 flex justify-start md:justify-end\">\n                    <Link \n                      href={project.href}\n                      className=\"inline-flex items-center gap-3 text-sm font-medium uppercase tracking-wider group-hover:text-foreground transition-colors text-muted-foreground\"\n                    >\n                      <span className=\"pb-1 border-b border-transparent group-hover:border-foreground transition-colors\">Voir l&apos;\303\251tude</span>\n                      <ArrowUpRight className=\"w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform\" />\n                    </Link>\n                  </div>\n                </div>\n              </Reveal>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* BOTTOM CTA */}\n      <section className=\"py-32 px-6 border-t border-border bg-foreground text-background\">\n        <div className=\"max-w-4xl mx-auto text-center flex flex-col items-center\">\n          <Reveal>\n            <h2 className=\"text-4xl md:text-5xl lg:text-7xl font-serif mb-8 text-balance\">\n              Vous avez un projet en t\303\252te ?\n            </h2>\n          </Reveal>\n          <Reveal delay={0.1}>\n            <p className=\"text-lg text-background/70 mb-12 leading-relaxed max-w-xl text-center\">\n              Nous collaborons avec des leaders avant-gardistes pour construire l&apos;avenir. Discutons de votre vision.\n            </p>\n          </Reveal>\n          <Reveal delay={0.2}>\n            <Link \n              href=\"/contact\" \n              className=\"inline-flex items-center justify-center px-10 py-5 text-sm font-medium text-foreground bg-background hover:bg-background/90 transition-colors uppercase tracking-widest rounded-none\"\n            >\n              D\303\251marrer une conversation\n            </Link>\n          </Reveal>\n        </div>\n      </section>\n    </div>\n  );\n}\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Digital Dunamis Website Remix\",\n  \"description\": \"A high-performing website for a professional technology Dunamis, designed with Google-level usability, Apple-level attention to detail, and a premium anti-slop aesthetic.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /next.config.ts ---\n```typescript\nimport type {NextConfig} from \'next\';\n\nconst nextConfig: NextConfig = {\n  reactStrictMode: true,\n  eslint: {\n    ignoreDuringBuilds: true,\n  },\n  typescript: {\n    ignoreBuildErrors: false,\n  },\n  // Allow access to remote image placeholder.\n  images: {\n    remotePatterns: [\n      {\n        protocol: \'https\',\n        hostname: \'picsum.photos\',\n        port: \'\',\n        pathname: \'/**\', // This allows any path under the hostname\n      },\n    ],\n  },\n  output: \'standalone\',\n  transpilePackages: [\'motion\'],\n  webpack: (config, {dev}) => {\n    // HMR is disabled in AI Studio via DISABLE_HMR env var.\n    // Do not modify\303\242\302\200\302\224file watching is disabled to prevent flickering during agent edits.\n    if (dev && process.env.DISABLE_HMR === \'true\') {\n      config.watchOptions = {\n        ignored: /.*/,\n      };\n    }\n    return config;\n  },\n};\n\nexport default