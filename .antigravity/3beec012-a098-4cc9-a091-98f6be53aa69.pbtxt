          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <h2 className=\"text-3xl md:text-4xl font-serif mb-12 text-center\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
