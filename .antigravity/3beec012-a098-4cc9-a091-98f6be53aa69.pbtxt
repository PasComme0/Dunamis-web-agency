        }
        lines {
          text: "                <h3 className=\"text-3xl md:text-4xl lg:text-5xl font-serif leading-snug mb-10 text-balance\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  Nous existons pour combler le foss\303\251 entre des objectifs commerciaux ambitieux et une ex\303\251cution technique sans faille."
